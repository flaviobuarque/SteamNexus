<ui:FluentWindow
    x:Class="SteamSwitcher.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:local="clr-namespace:SteamSwitcher.Views.Pages"
    xmlns:controls="clr-namespace:SteamSwitcher.Views.Controls"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    Title="SteamSwitcher"
    Width="950"
    Height="620"
    MinWidth="950"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavItemStyle" TargetType="ui:NavigationViewItem">
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="">
            <ui:TitleBar.Header>
                <Image
            Source="pack://application:,,,/Assets/logo.png"
            Height="22"
            Width="105"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            RenderOptions.BitmapScalingMode="HighQuality"
            Stretch="Uniform" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border
            Grid.Row="0"
            Height="2"
            VerticalAlignment="Bottom"
            Background="{DynamicResource AppAccentAltBrush}" />

        <!-- Banner Steam não instalado -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource AppDangerBrush}"
            Padding="16,10"
            Visibility="{Binding SteamNotFound, Converter={StaticResource BoolToVisibility}}"
            VerticalAlignment="Top"
            Panel.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Steam não detectado. Algumas funcionalidades estarão indisponíveis."
                    VerticalAlignment="Center"
                    Foreground="White" />
                <ui:Button
                    Grid.Column="1"
                    Content="Verificar instalação"
                    Appearance="Secondary"
                    Command="{Binding VerifySteamCommand}" />
            </Grid>
        </Border>

        <!-- Layout principal: sidebar + conteúdo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border
        Grid.Column="0"
        Background="{DynamicResource AppBackgroundBrush}"
        BorderThickness="0,0,1,0"
        BorderBrush="{DynamicResource AppBorderBrush}">
                <DockPanel>

                    <!-- Itens principais — centralizados verticalmente -->
                    <StackPanel
                DockPanel.Dock="Bottom"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8">

                        <!-- Tema -->
                        <Border
                    x:Name="ThemeNavItem"
                    Width="40" Height="40"
                    CornerRadius="10"
                    Margin="8,2"
                    Cursor="Hand"
                    ToolTip="Tema"
                    ToolTipService.InitialShowDelay="300">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ApplyThemeCommand}" CommandParameter="Dark">
                                        <MenuItem.Header>
                                            <Grid Width="104">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Escuro" VerticalAlignment="Center" />
                                                <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                                    Foreground="{DynamicResource AppAccentBrush}"
                                                    Visibility="{Binding IsDarkThemeSelected,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </MenuItem.Header>
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="WeatherMoon24"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding ApplyThemeCommand}" CommandParameter="Light">
                                        <MenuItem.Header>
                                            <Grid Width="104">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Claro" VerticalAlignment="Center" />
                                                <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                                    Foreground="{DynamicResource AppAccentBrush}"
                                                    Visibility="{Binding IsLightThemeSelected,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </MenuItem.Header>
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="WeatherSunny24"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding ApplyThemeCommand}" CommandParameter="System">
                                        <MenuItem.Header>
                                            <Grid Width="104">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sistema" VerticalAlignment="Center" />
                                                <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                                    Foreground="{DynamicResource AppAccentBrush}"
                                                    Visibility="{Binding IsSystemThemeSelected,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </MenuItem.Header>
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Desktop24"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ui:SymbolIcon Symbol="DarkTheme24" FontSize="18" Foreground="{DynamicResource AppTextMutedBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Configurações -->
                        <Border
                    Width="40" Height="40"
                    CornerRadius="10"
                    Margin="8,2"
                    Cursor="Hand"
                    ToolTip="Configurações"
                    ToolTipService.InitialShowDelay="300"
                    MouseLeftButtonUp="NavItem_Settings_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Settings">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActivePage,
                    RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>

                        <!-- Sobre -->
                        <Border
                    Width="40" Height="40"
                    CornerRadius="10"
                    Margin="8,2"
                    Cursor="Hand"
                    ToolTip="Sobre"
                    ToolTipService.InitialShowDelay="300"
                    MouseLeftButtonUp="NavItem_About_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="About">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="Info24" FontSize="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActivePage,
                    RelativeSource={RelativeSource AncestorType=Window}}" Value="About">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                    </StackPanel>

                    <!-- Itens de navegação — centro vertical -->
                    <StackPanel VerticalAlignment="Center">

                        <!-- Contas -->
                        <Border
                    Width="40" Height="40"
                    CornerRadius="10"
                    Margin="8,2"
                    Cursor="Hand"
                    ToolTip="Contas"
                    ToolTipService.InitialShowDelay="300"
                    MouseLeftButtonUp="NavItem_Accounts_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Accounts">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="People24" FontSize="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActivePage,
                                                RelativeSource={RelativeSource AncestorType=Window}}" Value="Accounts">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>

                        <!-- Jogos -->
                        <Border
                    Width="40" Height="40"
                    CornerRadius="10"
                    Margin="8,2"
                    Cursor="Hand"
                    ToolTip="Jogos"
                    ToolTipService.InitialShowDelay="300"
                    MouseLeftButtonUp="NavItem_Games_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Games">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="XboxController24" FontSize="18"
    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActivePage,
                    RelativeSource={RelativeSource AncestorType=Window}}" Value="Games">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>

                        <!-- Modificações — reativar: FeatureFlags.Mods = true -->
                        <Border
                    x:Name="NavItemMods"
                    Width="40" Height="40"
                    CornerRadius="10"
                    Margin="8,2"
                    Cursor="Hand"
                    ToolTip="Modificações"
                    ToolTipService.InitialShowDelay="300"
                    Visibility="Collapsed"
                    MouseLeftButtonUp="NavItem_Mods_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Mods">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActivePage,
                                                RelativeSource={RelativeSource AncestorType=Window}}" Value="Mods">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Área de conteúdo -->
            <Frame
        x:Name="MainFrame"
        Grid.Column="1"
        NavigationUIVisibility="Hidden" />

            <!-- Overlays -->
            <Grid Grid.Column="1">
                <ui:ContentDialogHost x:Name="RootContentDialogHost" />
                <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
            </Grid>
        </Grid>

        <!-- Tray icon -->
        <tray:NotifyIcon
            x:Name="TrayIcon"
            Grid.Row="0"
            Grid.RowSpan="3"
            FocusOnLeftClick="False"
            LeftDoubleClick="TrayIcon_LeftDoubleClick"
            Icon="pack://application:,,,/Assets/icon.ico"
            TooltipText="{Binding TrayTooltip}">
            <tray:NotifyIcon.Menu>
                <ContextMenu
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <!-- Conta ativa -->
                    <MenuItem IsEnabled="False">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="2,4,8,4">

                                <!-- Avatar circular -->
                                <Border
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSwitchingAccount}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Ellipse Width="28" Height="28" Fill="White" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>

                                    <Grid>
                                        <!-- Fallback: ícone de pessoa -->
                                        <ui:SymbolIcon
                                            Symbol="Person24"
                                            FontSize="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AppTextMutedBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveAccountAvatarPath}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- Avatar carregado -->
                                        <Image
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding ActiveAccountAvatarPath,
                                                Converter={StaticResource PathToImageSource}}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveAccountAvatarPath}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Nome e label -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding ActiveAccountName}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <controls:BusyRing
                                        Width="10" Height="10"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSwitchingAccount,
                                            Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                        Text="{Binding TrayAccountStatusText}"
                                        FontSize="10"
                                        Foreground="{DynamicResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <Separator />

                    <!-- Abrir / Ocultar -->
                    <MenuItem
                Header="{Binding ToggleWindowText}"
                Command="{Binding ToggleWindowCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Eye24" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />

                    <!-- Sair -->
                    <MenuItem
                Header="Sair"
                Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Power24" />
                        </MenuItem.Icon>
                    </MenuItem>

                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <!-- Status bar -->
        <Border
            Grid.Row="2"
            Height="36"
            Padding="16,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppChromeBrush}"
            Visibility="{Binding StatusBarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{Binding StatusBarLeft}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AppTextMutedBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding StatusBarRight}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AppTextMutedBrush}"
                        Margin="0,0,16,0"
                        Visibility="{Binding StatusBarRight, Converter={StaticResource EmptyStringToVisibility}}" />

                    <Button
                        Margin="0,0,8,0"
                        Padding="9,3"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Abrir configurações de atualização"
                        ToolTipService.InitialShowDelay="300"
                        Click="UpdateIndicator_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="UpdateBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="UpdateBorder" Property="Background"
                                                            Value="{DynamicResource AppSurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="UpdateBorder" Property="Opacity" Value="0.78" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding UpdateService.IsUpdateAvailable}" Value="True" />
                                            <Condition Binding="{Binding UpdateService.IsDownloading}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowDownload" FontSize="14"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding UpdateService.UpdateActionText}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding UpdateService.IsDownloading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="150" Height="5" Minimum="0" Maximum="100"
                                     Value="{Binding UpdateService.DownloadProgress}"
                                     VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding UpdateService.DownloadProgress, StringFormat={}{0}%}" />
                        <TextBlock Margin="7,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding UpdateService.DownloadSpeedText}" />
                    </StackPanel>

                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="6"
                        Padding="10,4"
                        Cursor="Hand"
                        ToolTip="Alternar estado de login"
                        ToolTipService.InitialShowDelay="300"
                        Visibility="{Binding ShowLoginToggle, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleLoginStateCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                        Width="7" Height="7"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AppTextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusLoginState}" Value="Online">
                                                <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                        Text="{Binding StatusLoginState}"
                        FontSize="12"
                        VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusLoginState}" Value="Online">
                                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
