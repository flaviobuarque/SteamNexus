<ui:FluentWindow
    x:Class="SteamSwitcher.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:local="clr-namespace:SteamSwitcher.Views.Pages"
    xmlns:controls="clr-namespace:SteamSwitcher.Views.Controls"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    Title="SteamNexus"
    Icon="pack://application:,,,/Assets/icon.ico"
    Width="950"
    Height="620"
    MinWidth="950"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="TrayInfoItemStyle" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{DynamicResource AppSurfaceBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ui:NavigationViewItem">
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="">
            <ui:TitleBar.Header>
                <Rectangle Height="22" Width="105" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Fill="{DynamicResource AppTextPrimaryBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border
            Grid.Row="0"
            Height="2"
            VerticalAlignment="Bottom"
            Background="{DynamicResource AppAccentAltBrush}" />

        <!-- Banner Steam não instalado -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource AppDangerBrush}"
            Padding="16,10"
            Visibility="{Binding SteamNotFound, Converter={StaticResource BoolToVisibility}}"
            VerticalAlignment="Top"
            Panel.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Steam não detectado. Algumas funcionalidades estarão indisponíveis."
                    VerticalAlignment="Center"
                    Foreground="White" />
                <ui:Button
                    Grid.Column="1"
                    Content="Verificar instalação"
                    Appearance="Secondary"
                    Command="{Binding VerifySteamCommand}" />
            </Grid>
        </Border>

        <!-- Layout principal: sidebar + conteúdo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border
        Grid.Column="0"
        Background="{DynamicResource AppBackgroundBrush}"
        BorderThickness="0,0,1,0"
        BorderBrush="{DynamicResource AppBorderBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,10,8,0">
                        <Button Style="{StaticResource NexusSidebarAction}" Margin="0,2"
                                Click="QuickSearch_Click" ToolTip="Busca rápida (Ctrl+K)" AutomationProperties.Name="Busca rápida">
                            <ui:SymbolIcon Symbol="Search24" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>

                    <!-- Itens principais — centralizados verticalmente -->
                    <StackPanel
                DockPanel.Dock="Bottom"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8">

                        <!-- Configurações -->
                        <Button
                            Click="NavItem_Settings_Click"
                            ToolTip="Configurações (Ctrl+,)"
                            ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="Configurações">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Settings">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>

                        <!-- Sobre -->
                        <Button
                            Click="NavItem_About_Click"
                            ToolTip="Sobre o SteamNexus"
                            ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="Sobre">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="About">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="About">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="Info24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Itens de navegação — centro vertical -->
                    <StackPanel VerticalAlignment="Center">

                        <!-- Contas -->
                        <Button
                            Click="NavItem_Accounts_Click"
                            ToolTip="Contas (Ctrl+1)"
                            ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="Contas">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Accounts">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Accounts">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="People24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>

                        <!-- Jogos -->
                        <Button
                            Click="NavItem_Games_Click"
                            ToolTip="Jogos (Ctrl+2)"
                            ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="Jogos">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Games">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Games">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="XboxController24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>

                        <!-- Atividade recente -->
                        <Button Margin="8,2" Click="Activity_Click" ToolTip="Atividade recente (Ctrl+3)"
                                ToolTipService.InitialShowDelay="300"
                                AutomationProperties.Name="Atividade recente">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusSidebarAction}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" /></Trigger>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Activity">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Activity">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="History24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>

                        <!-- Diagnóstico -->
                        <Button
                            Click="NavItem_Diagnostics_Click"
                            ToolTip="{Binding DiagnosticsTooltip}"
                            ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="Diagnóstico">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Diagnostics">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Diagnostics">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Border Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                    Background="{DynamicResource AppWarningBrush}" Visibility="{Binding HasDiagnosticIssues, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#141414" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Modificações — reativar: FeatureFlags.Mods = true -->
                        <Button
                            x:Name="NavItemMods"
                            Click="NavItem_Mods_Click"
                            ToolTip="Modificações"
                            ToolTipService.InitialShowDelay="300"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Modificações">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NexusNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePage}" Value="Mods">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="40" Height="40">
                                <Border Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Background="{DynamicResource AppAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mods">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Área de conteúdo -->
            <Frame
        x:Name="MainFrame"
        Grid.Column="1"
        NavigationUIVisibility="Hidden" />

            <!-- Overlays -->
            <Grid Grid.Column="1">
                <ui:ContentDialogHost x:Name="RootContentDialogHost" />
                <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
            </Grid>
        </Grid>

        <!-- Tray icon -->
        <tray:NotifyIcon
            x:Name="TrayIcon"
            Grid.Row="0"
            Grid.RowSpan="3"
            FocusOnLeftClick="False"
            LeftDoubleClick="TrayIcon_LeftDoubleClick"
            Icon="pack://application:,,,/Assets/icon.ico"
            TooltipText="{Binding TrayTooltip}">
            <tray:NotifyIcon.Menu>
                <ContextMenu
            Style="{StaticResource AppCardContextMenuStyle}"
            UseLayoutRounding="True" SnapsToDevicePixels="True"
            TextOptions.TextFormattingMode="Display"
            TextOptions.TextRenderingMode="ClearType"
            FontFamily="Segoe UI" FontSize="14"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="8" RenderOptions.ClearTypeHint="Enabled"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource AppCardMenuItemStyle}" />
                    </ContextMenu.Resources>

                    <!-- Conta ativa -->
                    <MenuItem Style="{StaticResource TrayInfoItemStyle}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="2,4,8,4">

                                <!-- Avatar circular -->
                                <Border
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSwitchingAccount}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Ellipse Width="28" Height="28" Fill="White" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>

                                    <Grid>
                                        <!-- Fallback: ícone de pessoa -->
                                        <ui:SymbolIcon
                                            Symbol="Person24"
                                            FontSize="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AppTextMutedBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveAccountAvatarPath}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- Avatar carregado -->
                                        <Image
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding ActiveAccountAvatarPath,
                                                Converter={StaticResource PathToImageSource}}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveAccountAvatarPath}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Nome e label -->
                                <StackPanel VerticalAlignment="Center" MaxWidth="250">
                                    <TextBlock
                                        Text="{Binding TrayAccountTitle}" TextWrapping="Wrap"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <controls:BusyRing
                                        Width="10" Height="10"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSwitchingAccount,
                                            Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                        Text="{Binding TrayAccountStatusText}"
                                        TextWrapping="Wrap" MaxWidth="250" Margin="0,3,0,0"
                                        FontSize="10"
                                        Foreground="{DynamicResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <Separator />

                    <MenuItem x:Name="TrayRunningGamesItem" Style="{StaticResource TrayInfoItemStyle}"
                        Visibility="{Binding HasRunningGames, Converter={StaticResource BoolToVisibility}}">
                        <MenuItem.Header>
                            <StackPanel Margin="2,4,8,4" MaxWidth="280">
                                <ItemsControl ItemsSource="{Binding RunningGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Grid Width="28" Height="28" Margin="0,0,9,0" VerticalAlignment="Center">
                                                    <Image Source="{Binding TrayIconImage}" Stretch="Uniform" />
                                                    <ui:SymbolIcon Symbol="Games24">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TrayIconImage}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Grid>
                                                <StackPanel>
                                                <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" MaxWidth="280"
                                                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus}" FontSize="10"
                                                    Foreground="{DynamicResource AppSuccessBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator x:Name="TrayRunningGamesSeparator"
                        Visibility="{Binding HasRunningGames, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Abrir / Ocultar -->
                    <MenuItem
                Header="{Binding ToggleWindowText}"
                Command="{Binding ToggleWindowCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Eye24" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />

                    <!-- Sair -->
                    <MenuItem
                Header="Sair"
                Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Power24" />
                        </MenuItem.Icon>
                    </MenuItem>

                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <!-- Status bar -->
        <Border
            Grid.Row="2"
            Height="36"
            Padding="16,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppChromeBrush}"
            Visibility="{Binding StatusBarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{Binding StatusBarLeft}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AppTextMutedBrush}" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowAccountGridDensityControls, Converter={StaticResource BoolToVisibility}}">
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip="Reduzir cartões"
                        IsEnabled="{Binding CanDecreaseAccountGridDensity}"
                        Command="{Binding DecreaseAccountGridDensityCommand}">
                        <ic:SymbolIcon Symbol="Subtract" FontSize="13" />
                    </Button>
                    <TextBlock
                        Width="42"
                        Text="{Binding AccountGridDensityText}"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource AppTextMutedBrush}" />
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip="Aumentar cartões"
                        IsEnabled="{Binding CanIncreaseAccountGridDensity}"
                        Command="{Binding IncreaseAccountGridDensityCommand}">
                        <ic:SymbolIcon Symbol="Add" FontSize="13" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowGameGridDensityControls, Converter={StaticResource BoolToVisibility}}">
                    <Button Width="26" Height="24" Padding="0" Cursor="Hand"
                            ToolTip="Reduzir pôsteres"
                            IsEnabled="{Binding CanDecreaseGameGridDensity}"
                            Command="{Binding DecreaseGameGridDensityCommand}">
                        <ic:SymbolIcon Symbol="Subtract" FontSize="13" />
                    </Button>
                    <TextBlock Width="42" Text="{Binding GameGridDensityText}"
                               TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                    <Button Width="26" Height="24" Padding="0" Cursor="Hand"
                            ToolTip="Aumentar pôsteres"
                            IsEnabled="{Binding CanIncreaseGameGridDensity}"
                            Command="{Binding IncreaseGameGridDensityCommand}">
                        <ic:SymbolIcon Symbol="Add" FontSize="13" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}" Value="Games">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel x:Name="GamePagination" Orientation="Horizontal" Margin="0,0,12,0"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                            <Button Width="26" Height="24" Padding="0" ToolTip="Página anterior"
                                    AutomationProperties.Name="Página anterior" Command="{Binding PreviousPageCommand}"
                                    IsEnabled="{Binding CanGoPreviousPage}">
                                <TextBlock Text="‹"/>
                            </Button>
                            <TextBlock Text="{Binding CompactPageText}" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                            <Button Width="26" Height="24" Padding="0" ToolTip="Próxima página"
                                    AutomationProperties.Name="Próxima página" Command="{Binding NextPageCommand}"
                                    IsEnabled="{Binding CanGoNextPage}">
                                <TextBlock Text="›"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Text="{Binding StatusBarRight}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AppTextMutedBrush}"
                        Margin="0,0,16,0"
                        Visibility="{Binding StatusBarRight, Converter={StaticResource EmptyStringToVisibility}}" />

                    <Button
                        Margin="0,0,8,0"
                        Padding="9,3"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Abrir configurações de atualização"
                        ToolTipService.InitialShowDelay="300"
                        Click="UpdateIndicator_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="UpdateBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="UpdateBorder" Property="Background"
                                                            Value="{DynamicResource AppSurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="UpdateBorder" Property="Opacity" Value="0.78" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding UpdateService.IsUpdateAvailable}" Value="True" />
                                            <Condition Binding="{Binding UpdateService.IsDownloading}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowDownload" FontSize="14"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding UpdateService.UpdateActionText}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding UpdateService.IsDownloading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="150" Height="5" Minimum="0" Maximum="100"
                                     Value="{Binding UpdateService.DownloadProgress}"
                                     VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding UpdateService.DownloadProgress, StringFormat={}{0}%}" />
                        <TextBlock Margin="7,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding UpdateService.DownloadSpeedText}" />
                    </StackPanel>

                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Padding="10,4"
                        Cursor="Hand"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        ToolTip="Modo de inicialização da Steam: Online / Offline. Clique para alternar."
                        ToolTipService.InitialShowDelay="300"
                        Visibility="{Binding ShowLoginToggle, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleLoginStateCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse
                                Width="7" Height="7"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AppTextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefaultLoginStateText}" Value="Online">
                                                <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                Text="Login Steam:"
                                FontSize="11"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock
                                Text="{Binding DefaultLoginStateText}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefaultLoginStateText}" Value="Online">
                                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ic:SymbolIcon Symbol="ArrowSwap" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
