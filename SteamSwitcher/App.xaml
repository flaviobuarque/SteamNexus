<Application
    x:Class="SteamSwitcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:models="clr-namespace:SteamSwitcher.Core.Models;assembly=SteamSwitcher.Core"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type ToolTip}">
                <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </Style.Resources>
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MaxWidth" Value="380" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LoginPreferenceBadgeStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Badge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ic:SymbolIcon x:Name="LoginStateIcon" Symbol="Settings" FontSize="12"
                                        Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding LoginPreferenceValue}" Value="{x:Static models:LoginState.Online}">
                                    <Setter TargetName="LoginStateIcon" Property="Symbol" Value="Globe" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LoginPreferenceValue}" Value="{x:Static models:LoginState.Offline}">
                                    <Setter TargetName="LoginStateIcon" Property="Symbol" Value="GlobeOff" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Badge" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Badge" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LoginPreferenceContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        <Style x:Key="AppCardMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppCardContextMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource LoginPreferenceContextMenuStyle}">
            <Style.Resources>
                <Style TargetType="Separator">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource AppBorderBrush}" />
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="AccountRestrictedMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource AppCardMenuItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGameRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountContextMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource AppCardContextMenuStyle}">
            <Style.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource AccountRestrictedMenuItemStyle}" /></Style.Resources>
        </Style>

            <Style x:Key="LoginPreferenceMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Check" Text="✓" Visibility="Hidden" Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>

            <Style x:Key="SteamSwitcherSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                <Setter Property="Margin" Value="0,22,0,10" />
            </Style>

            <Style x:Key="SteamSwitcherPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="SteamSwitcherPrimaryButtonStyle" TargetType="ui:Button">
                <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentAltBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="PrimaryButtonBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource AppButtonCornerRadius}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PrimaryButtonBorder" Property="Background"
                                            Value="{DynamicResource AppAccentAltBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PrimaryButtonBorder" Property="Opacity" Value="0.78" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PrimaryButtonBorder" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SteamSwitcherToggleSwitchStyle" TargetType="ui:ToggleSwitch">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:ToggleSwitch">
                            <Border x:Name="ToggleTrack" Width="42" Height="24" CornerRadius="12"
                                    Background="{DynamicResource AppSurfaceHoverBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <Ellipse x:Name="ToggleThumb" Width="16" Height="16" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource AppTextPrimaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleTrack" Property="Background"
                                            Value="{DynamicResource AppAccentBrush}" />
                                    <Setter TargetName="ToggleTrack" Property="BorderBrush"
                                            Value="{DynamicResource AppAccentAltBrush}" />
                                    <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="ToggleThumb" Property="Fill"
                                            Value="{DynamicResource AppOnAccentTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernSnackbarStyle" TargetType="ui:Snackbar">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="ContentForeground" Value="{DynamicResource AppTextSecondaryBrush}" />
                <Setter Property="Margin" Value="20" />
                <Setter Property="MinWidth" Value="360" />
                <Setter Property="MaxWidth" Value="460" />
                <Setter Property="MinHeight" Value="78" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Snackbar">
                            <Grid x:Name="ToastContainer" Opacity="0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ToastTransform" Y="18" />
                                </Grid.RenderTransform>
                                <Border
                                    x:Name="ToastCard"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" Direction="270"
                                            ShadowDepth="7" Opacity="0.28" Color="#050A12" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="AccentBar" Grid.Column="0"
                                            Margin="0,10,0,10" Background="{TemplateBinding Foreground}"
                                            CornerRadius="0,3,3,0" />

                                        <Border Grid.Column="1" Width="38" Height="38" Margin="14,0,12,0"
                                            VerticalAlignment="Center" CornerRadius="19"
                                            Background="{DynamicResource AppAccentSurfaceBrush}">
                                            <ContentPresenter Content="{TemplateBinding Icon}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                TextElement.FontSize="21"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>

                                        <Grid Grid.Column="2" Margin="0,14,4,14" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ContentPresenter Content="{TemplateBinding Title}"
                                                ContentTemplate="{TemplateBinding TitleTemplate}"
                                                TextElement.FontSize="14"
                                                TextElement.FontWeight="SemiBold"
                                                TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <ContentPresenter Grid.Row="1" Margin="0,3,0,0"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                TextElement.FontSize="12"
                                                TextElement.Foreground="{TemplateBinding ContentForeground}" />
                                        </Grid>

                                        <Button x:Name="CloseButton" Grid.Column="3"
                                            Width="32" Height="32" Margin="6,0,10,0"
                                            VerticalAlignment="Center" Cursor="Hand"
                                            Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CloseSurface" Background="Transparent" CornerRadius="8">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15"
                                                            Foreground="{DynamicResource AppTextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CloseSurface" Property="Background"
                                                                Value="{DynamicResource AppSurfaceHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsCloseButtonEnabled" Value="False">
                                    <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="AccentBar" Property="Margin" Value="0,10,0,10" />
                                </Trigger>
                                <Trigger Property="IsShown" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ToastContainer"
                                                    Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="ToastTransform"
                                                    Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ToastContainer"
                                                    Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="ToastTransform"
                                                    Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Success">
                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
                    </Trigger>
                    <Trigger Property="Appearance" Value="Danger">
                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                    </Trigger>
                    <Trigger Property="Appearance" Value="Caution">
                        <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Frame">
                <Setter Property="NavigationUIVisibility" Value="Hidden" />
            </Style>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <converters:PathToImageSourceConverter x:Key="PathToImageSource" />
            <converters:EnumToBoolConverter x:Key="EnumToBool" />
            <converters:EmptyStringToBoolConverter x:Key="EmptyStringToBool" />
            <converters:NotNullToBoolConverter x:Key="NotNullToBool" />
            <converters:BoolToImportTextConverter x:Key="BoolToImportText" />
            <converters:BoolToGridLengthConverter x:Key="BoolToGridLength" />

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="MaxWidth" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        Background="{DynamicResource AppScrollThumbBrush}"
                                                        CornerRadius="3"
                                                        Margin="2,2" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
