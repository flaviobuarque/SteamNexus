<Page
    x:Class="SteamSwitcher.Views.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,26,30,36" MaxWidth="940" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnóstico da Steam" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Acompanhe e repare cada instalação separadamente."
                               Margin="0,7,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding CopyReportCommand}" Appearance="Secondary"
                               ToolTip="Copiar relatórios de todas as instalações" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Copy" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="Copiar todos" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Command="{Binding RefreshCommand}" Appearance="Primary"
                               ToolTip="Verificar todas as instalações novamente">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="Verificar todas" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding Installations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10">
                            <Expander.Template>
                                <ControlTemplate TargetType="Expander">
                                    <Border CornerRadius="14" Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              Background="Transparent" BorderThickness="0" Padding="18,14"
                                                              HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ic:SymbolIcon Symbol="HardDrive" FontSize="19" Margin="0,2,12,0"
                                                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                                                   Foreground="{DynamicResource AppAccentBrush}" />
                                                    <StackPanel Grid.Column="1" IsHitTestVisible="False">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Report.InstallationName}" FontSize="16" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="5"
                                                                    Background="{DynamicResource AppAccentSurfaceBrush}"
                                                                    Visibility="{Binding Report.IsSelected, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Selecionada" FontSize="9" Foreground="{DynamicResource AppAccentBrush}" />
                                                            </Border>
                                                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="5"
                                                                    Background="{DynamicResource AppSuccessSurfaceBrush}"
                                                                    Visibility="{Binding Report.IsRunning, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Em execução" FontSize="9" Foreground="{DynamicResource AppSuccessBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Report.InstallationPath}" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding CheckedAtText}" FontSize="11" Margin="0,8,0,0"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="16,0,10,0" VerticalAlignment="Center"
                                                                IsHitTestVisible="False">
                                                        <Border Padding="8,3" CornerRadius="6" Background="{DynamicResource AppSuccessSurfaceBrush}"
                                                                Visibility="{Binding Report.IsHealthy, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Saudável" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppSuccessBrush}" />
                                                        </Border>
                                                        <Border Padding="8,3" Margin="0,2" CornerRadius="6" Background="{DynamicResource AppWarningSurfaceBrush}"
                                                                Visibility="{Binding Report.HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding Report.WarningBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppWarningBrush}" />
                                                        </Border>
                                                        <Border Padding="8,3" Margin="0,2" CornerRadius="6" Background="{DynamicResource AppDangerSurfaceBrush}"
                                                                Visibility="{Binding Report.HasErrors, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding Report.ErrorBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppDangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    </Grid>
                                                </ToggleButton>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0"
                                                            VerticalAlignment="Center">
                                                        <ui:Button Width="34" Height="34" Padding="0" Appearance="Secondary"
                                                                   ToolTip="Copiar relatório desta instalação"
                                                                   Command="{Binding DataContext.CopyInstallationReportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Copy" FontSize="15" />
                                                        </ui:Button>
                                                        <ui:Button Width="34" Height="34" Padding="0" Margin="6,0,0,0" Appearance="Secondary"
                                                                   ToolTip="Verificar somente esta instalação"
                                                                   Command="{Binding DataContext.RefreshInstallationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="15" />
                                                        </ui:Button>
                                                        <ui:Button Width="34" Height="34" Padding="0" Margin="6,0,0,0" Appearance="Secondary"
                                                                   ToolTip="Corrigir autologin do Registro"
                                                                   Visibility="{Binding Report.CanRepairRegistry, Converter={StaticResource BoolToVisibility}}"
                                                                   Command="{Binding DataContext.RepairRegistryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Wrench" FontSize="15" />
                                                        </ui:Button>
                                                        <ui:Button Width="34" Height="34" Padding="0" Margin="6,0,0,0" Appearance="Secondary"
                                                                   ToolTip="Desativar seletor de contas"
                                                                   Visibility="{Binding Report.CanDisableChooser, Converter={StaticResource BoolToVisibility}}"
                                                                   Command="{Binding DataContext.DisableChooserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Person" FontSize="15" />
                                                        </ui:Button>
                                                        <ToggleButton Width="34" Height="34" Margin="8,0,0,0" Padding="0"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                      ToolTip="Expandir ou recolher detalhes"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                            <ic:SymbolIcon x:Name="ExpansionChevron" Symbol="ChevronDown" FontSize="16"
                                                                           RenderTransformOrigin="0.5,0.5"
                                                                           Foreground="{DynamicResource AppTextMutedBrush}">
                                                                <ic:SymbolIcon.RenderTransform>
                                                                    <RotateTransform x:Name="ChevronRotation" Angle="0" />
                                                                </ic:SymbolIcon.RenderTransform>
                                                            </ic:SymbolIcon>
                                                            <ToggleButton.Triggers>
                                                                <EventTrigger RoutedEvent="ToggleButton.Checked">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotation"
                                                                                             Storyboard.TargetProperty="Angle"
                                                                                             To="180" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotation"
                                                                                             Storyboard.TargetProperty="Angle"
                                                                                             To="0" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </ToggleButton.Triggers>
                                                        </ToggleButton>
                                                </StackPanel>
                                            </Grid>
                                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Expander.Template>

                            <StackPanel Margin="16,0,16,16">
                                <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Report.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="10"
                                                    Background="{DynamicResource AppSurfaceAltBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="{DynamicResource AppSuccessSurfaceBrush}"
                                                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}">
                                                        <ic:SymbolIcon Symbol="Checkmark" FontSize="16"
                                                                       Foreground="{DynamicResource AppSuccessBrush}" />
                                                    </Border>
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="{DynamicResource AppWarningSurfaceBrush}"
                                                            Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}">
                                                        <ic:SymbolIcon Symbol="Warning" FontSize="16"
                                                                       Foreground="{DynamicResource AppWarningBrush}" />
                                                    </Border>
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="{DynamicResource AppDangerSurfaceBrush}"
                                                            Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="16"
                                                                       Foreground="{DynamicResource AppDangerBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
