<Page
    x:Class="SteamSwitcher.Views.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,26,30,36" MaxWidth="920" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnóstico da Steam" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Verifique a instalação e aplique somente os reparos necessários."
                               Margin="0,7,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Copiar relatório" Command="{Binding CopyReportCommand}"
                               Appearance="Secondary" Margin="0,0,8,0" />
                    <ui:Button Content="Verificar novamente" Command="{Binding RefreshCommand}"
                               Appearance="Primary" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,18,0,12" Padding="18" CornerRadius="14"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding InstallationName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="{Binding InstallationPath}" Margin="0,5,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastCheckText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="16,13" CornerRadius="12"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="20"
                                                   Foreground="{DynamicResource AppSuccessBrush}"
                                                   Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}" />
                                    <ic:SymbolIcon Symbol="Warning" FontSize="20"
                                                   Foreground="{DynamicResource AppWarningBrush}"
                                                   Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="20"
                                                   Foreground="{DynamicResource AppDangerBrush}"
                                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,8,0,0" Padding="18" CornerRadius="14"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Reparos disponíveis" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Os reparos são independentes e só ficam disponíveis quando uma inconsistência é detectada."
                                   Margin="0,5,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Corrigir autologin do Registro"
                                       Command="{Binding RepairRegistryCommand}"
                                       IsEnabled="{Binding CanRepairRegistry}" Margin="0,0,8,0" />
                            <ui:Button Content="Desativar seletor de contas"
                                       Command="{Binding DisableChooserCommand}"
                                       IsEnabled="{Binding CanDisableChooser}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
