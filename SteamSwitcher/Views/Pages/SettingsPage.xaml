<Page
    x:Class="SteamSwitcher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:helpers="clr-namespace:SteamSwitcher.Helpers"
    xmlns:models="clr-namespace:SteamSwitcher.Core.Models;assembly=SteamSwitcher.Core"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="TileFirstStyle" TargetType="Border" BasedOn="{StaticResource TileStyle}">
            <Setter Property="CornerRadius" Value="10,10,0,0" />
        </Style>
        <Style x:Key="TileMiddleStyle" TargetType="Border" BasedOn="{StaticResource TileStyle}">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="TileLastStyle" TargetType="Border" BasedOn="{StaticResource TileStyle}">
            <Setter Property="CornerRadius" Value="0,0,10,10" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="SettingsNavButtonStyle" TargetType="ui:Button"
            BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16,26,14,20"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock
                        Text="SEÇÕES"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AppTextMutedBrush}"
                        Margin="10,0,0,12" />

                    <ui:Button x:Name="AccountNavButton"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="Account" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowSwap" FontSize="15" Margin="0,0,9,0" />
                            <TextBlock Text="Conta" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="SteamNavButton"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="Steam" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Games" FontSize="15" Margin="0,0,9,0" />
                            <TextBlock Text="Steam" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="IntegrationsNavButton"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="Integrations" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="PlugConnected" FontSize="15" Margin="0,0,9,0" />
                            <TextBlock Text="Integrações" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="MaintenanceNavButton"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="Maintenance" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Wrench" FontSize="15" Margin="0,0,9,0" />
                            <TextBlock Text="Manutenção" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="UpdatesNavButton"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="Updates" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowDownload" FontSize="15" Margin="0,0,9,0" />
                            <TextBlock Text="Atualizações" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="DangerNavButton"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="Danger" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Warning" FontSize="15"
                                Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,9,0" />
                            <TextBlock Text="Zona de risco" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>

            <ScrollViewer
                x:Name="SettingsScrollViewer"
                Grid.Column="1"
                Padding="32,28,32,24"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="SettingsScrollViewer_ScrollChanged">
            <StackPanel x:Name="SettingsContent" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- Header -->
                <StackPanel Margin="0,0,0,28">
                    <TextBlock
                        Text="Configurações"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock
                        Text="Aparência, comportamento de troca e dados locais."
                        FontSize="13"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        Margin="0,5,0,0" />
                </StackPanel>

                <!-- TROCA DE CONTA -->
                <TextBlock x:Name="AccountSection" Text="TROCA DE CONTA" Style="{StaticResource SteamSwitcherSectionTitleStyle}" />
                <StackPanel Margin="0,8,0,24">

                    <Border Style="{StaticResource TileFirstStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Instalação controlada" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Contas, jogos e trocas usam somente esta instalação."
                                           FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SteamInstallations}"
                                      SelectedItem="{Binding SelectedSteamInstallation, Mode=TwoWay}"
                                      MinHeight="40" Padding="10,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RootPath}" FontSize="11" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileMiddleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Nome da instalação" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Use um nome curto para identificar instalações em discos ou pastas diferentes."
                                           FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SteamInstallationDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding SelectedSteamInstallation.RootPath}"
                                     MinHeight="38" Padding="10,7" />
                            <ui:Button Grid.Column="2"
                                       Command="{Binding RenameSteamInstallationCommand}"
                                       ToolTip="Salvar nome da instalação"
                                       Padding="12,8" Margin="8,0,0,0">
                                <ic:SymbolIcon Symbol="Save" FontSize="15" />
                            </ui:Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileMiddleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSteamInstallation.StatusText, TargetNullValue=Nenhuma instalação encontrada}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedSteamInstallation.RootPath}"
                                           FontSize="12" Margin="0,3,20,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Command="{Binding BrowseSteamInstallationCommand}" Padding="12,8" Margin="0,0,8,0">
                                    <ic:SymbolIcon Symbol="FolderAdd" FontSize="15" />
                                </ui:Button>
                                <ui:Button Command="{Binding OpenSteamInstallationFolderCommand}" Padding="12,8" Margin="0,0,8,0">
                                    <ic:SymbolIcon Symbol="FolderOpen" FontSize="15" />
                                </ui:Button>
                                <ui:Button Command="{Binding DetectSteamInstallationsCommand}" Padding="12,8">
                                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="15" />
                                </ui:Button>
                                <ui:Button Command="{Binding RemoveSteamInstallationCommand}" Padding="12,8" Margin="8,0,0,0"
                                           IsEnabled="{Binding SelectedSteamInstallation.IsCustom}">
                                    <ic:SymbolIcon Symbol="Delete" FontSize="15" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileMiddleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ao trocar de conta" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Comportamento da janela após alternar perfil." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding AfterAccountSwitch}" SelectedValuePath="Tag" MinWidth="180" VerticalAlignment="Center" Cursor="Hand">
                                <ComboBoxItem Content="Minimizar para tray" Tag="{x:Static models:PostSwitchBehavior.MinimizeToTray}" />
                                <ComboBoxItem Content="Fechar app" Tag="{x:Static models:PostSwitchBehavior.Close}" />
                                <ComboBoxItem Content="Manter aberto" Tag="{x:Static models:PostSwitchBehavior.KeepOpen}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileMiddleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ao abrir jogo" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="O que acontece depois de lançar um jogo." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding AfterGameLaunch}" SelectedValuePath="Tag" MinWidth="180" VerticalAlignment="Center" Cursor="Hand">
                                <ComboBoxItem Content="Minimizar para tray" Tag="{x:Static models:PostSwitchBehavior.MinimizeToTray}" />
                                <ComboBoxItem Content="Fechar app" Tag="{x:Static models:PostSwitchBehavior.Close}" />
                                <ComboBoxItem Content="Manter aberto" Tag="{x:Static models:PostSwitchBehavior.KeepOpen}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileMiddleStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Título e toggle -->
                            <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Text="Atalho global"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AppTextPrimaryBrush}"
            VerticalAlignment="Center" />

                            <ui:ToggleSwitch
            Grid.Row="0"
            Grid.Column="1"
            IsChecked="{Binding IsGlobalHotkeyEnabled}"
            VerticalAlignment="Center"
            Cursor="Hand" />

                            <!-- Descrição: ocupa toda a largura -->
                            <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,4,0,0"
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{DynamicResource AppTextMutedBrush}"
            Text="Mostra ou oculta a janela mesmo quando o Steam Switcher está em segundo plano." />

                            <!-- Combinação atual e ação -->
                            <Grid
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    MinHeight="42"
                                    Padding="12,8"
                                    CornerRadius="8"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlobalHotkeyEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ic:SymbolIcon
                                            Symbol="Keyboard"
                                            FontSize="16"
                                            Foreground="{DynamicResource AppAccentBrush}"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding HotkeyDisplayText}"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>

                                <ui:Button
                                    Grid.Column="2"
                                    MinWidth="132"
                                    MinHeight="42"
                                    Padding="14,8"
                                    Appearance="Secondary"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="{Binding IsGlobalHotkeyEnabled}"
                                    Click="BeginHotkeyCapture_Click"
                                    Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon Symbol="Edit" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding HotkeyButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Status padrão de login" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Usado quando a conta não possui override." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Online" GroupName="LoginState" Margin="0,0,16,0" Cursor="Hand"
                IsChecked="{Binding DefaultLoginStateOverride, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LoginState.Online}}" />
                                <RadioButton Content="Offline" GroupName="LoginState" Cursor="Hand"
                IsChecked="{Binding DefaultLoginStateOverride, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LoginState.Offline}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- STEAM -->
                <TextBlock x:Name="SteamSection" Text="STEAM" Style="{StaticResource SteamSwitcherSectionTitleStyle}" />
                <StackPanel Margin="0,8,0,24">

                    <Border Style="{StaticResource TileFirstStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Abrir Steam minimizada após trocar de conta"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />

                                <TextBlock
                                    Text="Aplica-se à troca manual de conta e à troca realizada antes de abrir um jogo."
                                    FontSize="12"
                                    Foreground="{DynamicResource AppTextMutedBrush}"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartSilent}" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileMiddleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Iniciar como administrador" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Use apenas se o Steam exigir elevação." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartAsAdmin}" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Iniciar com Windows" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Abre minimizado no tray ao ligar o PC." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- INTEGRAÇÕES -->
                <TextBlock x:Name="IntegrationsSection" Text="INTEGRAÇÕES" Style="{StaticResource SteamSwitcherSectionTitleStyle}" />
                <StackPanel Margin="0,8,0,24">

                    <!-- Reativar: FeatureFlags.SteamWebApiKey = true -->
                    <Border x:Name="SteamApiKeyTile" Style="{StaticResource TileFirstStyle}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Steam Web API Key" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0">
                                    <Run Text="Consulta conquistas e bans com mais precisão. " />
                                    <Hyperlink NavigateUri="https://steamcommunity.com/dev/apikey" RequestNavigate="Hyperlink_RequestNavigate">Obter key</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <ui:PasswordBox
                                x:Name="SteamApiKeyBox"
                                Grid.Column="1"
                                PlaceholderText="Opcional"
                                VerticalAlignment="Center"
                                PasswordChanged="SteamApiKeyBox_PasswordChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="SteamGridDbApiKeyTile" Style="{StaticResource TileStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SteamGridDB API Key" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0">
                                    <Run Text="Fallback para capas não encontradas na Steam CDN. " />
                                    <Hyperlink NavigateUri="https://www.steamgriddb.com/profile/preferences/api" RequestNavigate="Hyperlink_RequestNavigate">Obter key</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <ui:PasswordBox
                                x:Name="SteamGridDbApiKeyBox"
                                Grid.Column="1"
                                PlaceholderText="Opcional"
                                VerticalAlignment="Center"
                                PasswordChanged="SteamGridDbApiKeyBox_PasswordChanged" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- MANUTENÇÃO -->
                <TextBlock x:Name="MaintenanceSection" Text="MANUTENÇÃO" Style="{StaticResource SteamSwitcherSectionTitleStyle}" />
                <StackPanel Margin="0,8,0,24">
                    <Border Style="{StaticResource TileFirstStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cache de imagens" FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock
                    Text="{Binding CacheSizeText}"
                    FontSize="12"
                    Foreground="{DynamicResource AppTextMutedBrush}"
                    Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:Button
                Grid.Column="1"
                Appearance="Secondary"
                Padding="14,8"
                VerticalAlignment="Center"
                Cursor="Hand"
                Command="{Binding ClearCacheCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,7,0" />
                                    <TextBlock Text="Limpar cache" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Limpar contas antigas" FontWeight="SemiBold"
                                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock
                                    Text="Remove do loginusers.vdf contas que não são acessadas há meses. A conta ativa é protegida."
                                    FontSize="12" TextWrapping="Wrap"
                                    Foreground="{DynamicResource AppTextMutedBrush}"
                                    Margin="0,3,24,0" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Secondary"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Click="CleanupOldAccounts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,7,0" />
                                    <TextBlock Text="Selecionar período" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ATUALIZAÇÕES -->
                <TextBlock x:Name="UpdatesSection" Text="ATUALIZAÇÕES" Style="{StaticResource SteamSwitcherSectionTitleStyle}" />
                <StackPanel Margin="0,8,0,24">
                    <Border Style="{StaticResource TileFirstStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Versão instalada" FontWeight="SemiBold"
                                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{Binding UpdateService.CurrentVersion, StringFormat=Versão {0}}"
                                    FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,8"
                                IsEnabled="{Binding UpdateService.CanCheckForUpdates}"
                                Command="{Binding CheckForUpdatesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="14" Margin="0,0,7,0" />
                                    <TextBlock Text="Verificar atualizações" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileLastStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateService.StatusText}"
                                        FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding UpdateService.ErrorText}"
                                        FontSize="11" TextWrapping="Wrap"
                                        Foreground="{DynamicResource AppDangerBrush}" Margin="0,3,20,0"
                                        Visibility="{Binding UpdateService.ErrorText,
                                            Converter={StaticResource EmptyStringToVisibility}}" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Appearance="Primary" Padding="14,8"
                                    Command="{Binding DownloadUpdateCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateService.IsUpdateAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateService.IsUpdateReady}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon Symbol="ArrowDownload" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="Baixar atualização" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Grid.Column="1" Appearance="Primary" Padding="14,8"
                                    Command="{Binding ApplyUpdateAndRestartCommand}"
                                    Visibility="{Binding UpdateService.IsUpdateReady,
                                        Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="Reiniciar e atualizar" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <ProgressBar Height="5" Minimum="0" Maximum="100"
                                Value="{Binding UpdateService.DownloadProgress}"
                                Margin="0,14,0,0"
                                Foreground="{DynamicResource AppAccentBrush}"
                                Visibility="{Binding UpdateService.IsDownloading,
                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ZONA DE RISCO -->
                <TextBlock x:Name="DangerSection" Text="ZONA DE RISCO" Style="{StaticResource SteamSwitcherSectionTitleStyle}" />
                <Border
                    Margin="0,8,0,28"
                    Background="{DynamicResource AppDangerSurfaceBrush}"
                    BorderBrush="{DynamicResource AppDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Apagar dados do Steam Switcher" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock
                                Text="Remove configurações, cache e overrides. O app reabre como primeira execução. Dados da Steam não são afetados."
                                FontSize="12"
                                Foreground="{DynamicResource AppTextSecondaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,4,24,0" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Cursor="Hand"
                            Appearance="Danger"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Command="{Binding ResetAppDataCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ic:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Apagar dados" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Barra de salvar fixa -->
        <Border
            Grid.Row="1"
            Padding="32,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppChromeBrush}"
            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                    <ic:SymbolIcon Symbol="Warning" FontSize="15"
                        Foreground="{DynamicResource AppWarningBrush}"
                        Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Há alterações não salvas"
                        Foreground="{DynamicResource AppWarningBrush}"
                        FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Secondary"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Command="{Binding UndoCommand}"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowUndo" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Desfazer" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button
                        Appearance="Primary"
                        Padding="20,8"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Save" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Salvar configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
