<Page x:Class="SteamSwitcher.Views.Pages.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SteamSwitcher.Views.Controls"
      xmlns:core="clr-namespace:SteamSwitcher.Core.Services;assembly=SteamSwitcher.Core"
      Title="Atividade recente"
      Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ActivityAction" TargetType="Button" BasedOn="{StaticResource NexusActionButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        </Style>

        <Style x:Key="KpiCardButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexusKeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityCard" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexusKeyboardFocus}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource AppSurfaceBrush}"
                                x:Name="CardSurface">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" FocusVisualStyle="{StaticResource NexusKeyboardFocus}" AutomationProperties.Name="{Binding Title}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                <Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L5,5 10,0"
                                                      Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Atividade recente" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="StorageNotice" Text="Últimas 200 operações salvas neste computador. Sem senhas ou chaves."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="ExportStatusText" Text="Copiado para a área de transferência!" Foreground="{DynamicResource AppSuccessBrush}"
                               FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Style="{StaticResource NexusActionButton}" Click="Export_Click"
                        ToolTip="Copiar todo o histórico filtrado para a área de transferência" Height="38" Padding="12,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Exportar" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActivityAction}" Click="Monitoring_Click" ToolTip="Medições do monitoramento" AutomationProperties.Name="Medições do monitoramento">
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ActivityAction}" Click="Refresh_Click" ToolTip="Atualizar histórico" AutomationProperties.Name="Atualizar histórico">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                </Button>
                <Button x:Name="ClearButton" Style="{StaticResource ActivityAction}" Click="Clear_Click" ToolTip="Limpar histórico salvo" AutomationProperties.Name="Limpar histórico salvo">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- KPIs Strip -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total -->
            <Button Grid.Column="0" Style="{StaticResource KpiCardButton}" Click="KpiTotal_Click" ToolTip="Clique para ver todos os registros">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiTotalText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Trocas -->
            <Button Grid.Column="2" Style="{StaticResource KpiCardButton}" Click="KpiSwitches_Click" ToolTip="Filtrar por trocas de conta">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AppAccentSurfaceBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="People24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Trocas de Conta" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiSwitchesText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Jogos -->
            <Button Grid.Column="4" Style="{StaticResource KpiCardButton}" Click="KpiGames_Click" ToolTip="Filtrar por inícios de jogo">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AppSuccessSurfaceBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="XboxController24" FontSize="16" Foreground="{DynamicResource AppSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Jogos Iniciados" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiGamesText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppSuccessBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Falhas / Atenção -->
            <Button Grid.Column="6" x:Name="KpiAttentionCard" Style="{StaticResource KpiCardButton}" Click="KpiAttention_Click" ToolTip="Filtrar por registros que exigem atenção">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KpiAttentionIconBorder" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon x:Name="KpiAttentionIcon" Symbol="Warning24" FontSize="16" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Atenção / Falhas" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiAttentionText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <!-- Filters Strip -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <WrapPanel VerticalAlignment="Center">
                <!-- Search Input -->
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Pesquisar" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="SearchBox" Width="220" Height="36" PlaceholderText="Buscar conta, jogo, detalhe..." TextChanged="SearchBox_TextChanged">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </StackPanel>

                <!-- Period Picker -->
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Data ou período" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                    <controls:HistoryPeriodPicker x:Name="PeriodPicker" />
                </StackPanel>

                <!-- Type Filter -->
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Tipo de registro" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="TypeFilter" Width="210" Height="36" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Tipo de registro">
                        <ComboBoxItem Content="Todos os tipos" />
                        <ComboBoxItem Content="Troca de conta" />
                        <ComboBoxItem Content="Início de jogo" />
                        <ComboBoxItem Content="Correção da Steam" />
                        <ComboBoxItem Content="Atualização" />
                        <ComboBoxItem Content="Recuperação de configurações" />
                        <ComboBoxItem Content="Somente falhas / atenção" />
                    </ComboBox>
                </StackPanel>

                <!-- Clear Filters Button -->
                <Button x:Name="ClearFiltersButton" Visibility="Collapsed" Content="Limpar filtros" Height="36" Padding="14,0"
                        Margin="0,0,10,6" VerticalAlignment="Bottom" Style="{StaticResource NexusActionButton}" Click="ClearFilters_Click" />

                <!-- Preview Toggle (Debug) -->
                <Button x:Name="PreviewToggle" Visibility="Collapsed" Content="Sair da prévia" Height="36" Padding="14,0"
                        Margin="0,0,10,6" VerticalAlignment="Bottom" Style="{StaticResource NexusActionButton}" Click="Preview_Click" />
            </WrapPanel>

            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="Summary" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="NewActivity" Content="Novas atividades · Clique para atualizar" Visibility="Collapsed"
                        HorizontalAlignment="Right" Style="{StaticResource NexusActionButton}" Height="30" Padding="12,0" Click="Refresh_Click" />
            </Grid>
        </StackPanel>

        <!-- Entries List -->
        <Grid Grid.Row="3">
            <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.ScrollChanged="Entries_ScrollChanged"
                     ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource ActivityCard}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="False" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter Margin="0,0,12,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch" Style="{StaticResource ActivityExpander}" AutomationProperties.Name="{Binding Title}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Info24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.AccountSwitched}">
                                                            <Setter Property="Symbol" Value="People24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.AccountSwitchFailed}">
                                                            <Setter Property="Symbol" Value="People24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameStarted}">
                                                            <Setter Property="Symbol" Value="XboxController24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameLaunchFailed}">
                                                            <Setter Property="Symbol" Value="XboxController24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.PreferenceRepaired}">
                                                            <Setter Property="Symbol" Value="Wrench24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.RepairFailed}">
                                                            <Setter Property="Symbol" Value="Wrench24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.UpdateReady}">
                                                            <Setter Property="Symbol" Value="ArrowDownload24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentAltBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.UpdateFailed}">
                                                            <Setter Property="Symbol" Value="ArrowDownload24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.SettingsRecovered}">
                                                            <Setter Property="Symbol" Value="History24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Border>

                                    <!-- Title & Context -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Category Badge -->
                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                    Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            </Border>

                                            <!-- Status Badge -->
                                            <Border Margin="5,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource AppSuccessSurfaceBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Sucesso" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                    <Setter Property="Text" Value="Falha" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Subtitle (Account Transition / Game Name / Operation) -->
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Right: Relative Time and Copy Button -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RelativeTime}" ToolTip="{Binding TimeText}"
                                                   FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <Button Style="{StaticResource NexusSidebarAction}" Width="30" Height="30"
                                                Click="CopyEntry_Click" Tag="{Binding}" Margin="0,0,4,0" ToolTip="Copiar detalhes deste registro">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <!-- Expanded Details Panel -->
                            <Border Margin="48,10,0,4" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DETALHES DA OPERAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" LineHeight="18"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Search24" FontSize="44" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="Empty" Text="Nenhum registro encontrado." FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Ajuste os termos de busca, o período ou limpe os filtros." FontSize="12"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12" />
                <Button Content="Limpar filtros" HorizontalAlignment="Center" Style="{StaticResource NexusActionButton}" Click="ClearFilters_Click" />
            </StackPanel>
        </Grid>

        <!-- Footer / Pagination -->
        <Grid Grid.Row="4" Margin="0,10,12,0">
            <Button x:Name="LoadMore" Content="Carregar mais 30" HorizontalAlignment="Center" Style="{StaticResource NexusActionButton}" Click="LoadMore_Click" Visibility="Collapsed" />
            <TextBlock x:Name="EndNotice" Text="Todos os registros carregados" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" Visibility="Collapsed" />
            <Button x:Name="TopButton" HorizontalAlignment="Right" Visibility="Collapsed" ToolTip="Voltar ao topo" AutomationProperties.Name="Voltar ao topo" Style="{StaticResource ActivityAction}" Click="Top_Click">
                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Page>
