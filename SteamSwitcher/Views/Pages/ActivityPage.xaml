<Page x:Class="SteamSwitcher.Views.Pages.ActivityPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:SteamSwitcher.Views.Controls"
        xmlns:core="clr-namespace:SteamSwitcher.Core.Services;assembly=SteamSwitcher.Core"
        Title="Atividade recente"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="ActivityAction" TargetType="Button" BasedOn="{StaticResource NexusActionButton}">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        </Style>
        <Style x:Key="ActivityCard" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexusKeyboardFocus}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{DynamicResource AppSuccessBrush}" Background="{DynamicResource AppSuccessSurfaceBrush}" x:Name="CardSurface">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                        <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                        <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActivityExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Cursor="Hand" FocusVisualStyle="{StaticResource NexusKeyboardFocus}" AutomationProperties.Name="{Binding Title}"
                                  HorizontalContentAlignment="Stretch">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="0,3">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    <Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L5,5 10,0" Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="30,22,22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Atividade recente" FontSize="25" FontWeight="Bold" />
                <TextBlock x:Name="StorageNotice" Text="Últimas 200 operações salvas neste computador. Sem senhas ou chaves."
                           TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActivityAction}" Click="Monitoring_Click" ToolTip="Medições do monitoramento" AutomationProperties.Name="Medições do monitoramento"><ui:SymbolIcon Symbol="Desktop24" FontSize="18" /></Button>
                <Button Style="{StaticResource ActivityAction}" Click="Refresh_Click" ToolTip="Atualizar histórico" AutomationProperties.Name="Atualizar histórico"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" /></Button>
                <Button x:Name="ClearButton" Style="{StaticResource ActivityAction}" Click="Clear_Click" ToolTip="Limpar histórico salvo" AutomationProperties.Name="Limpar histórico salvo"><ui:SymbolIcon Symbol="Delete24" FontSize="18" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" />
            <Button Grid.Column="1" x:Name="PreviewToggle" Visibility="Collapsed" Content="Sair da prévia"
                    Style="{StaticResource NexusActionButton}" Click="Preview_Click" />
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Data ou período" Margin="0,0,0,4" /><controls:HistoryPeriodPicker x:Name="PeriodPicker" /></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Tipo de registro" Margin="0,0,0,4" /><ComboBox x:Name="TypeFilter" Width="210" Height="36" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Tipo de registro">
                    <ComboBoxItem Content="Todos os tipos" /><ComboBoxItem Content="Troca de conta" /><ComboBoxItem Content="Início de jogo" /><ComboBoxItem Content="Correção da Steam" /><ComboBoxItem Content="Atualização" /><ComboBoxItem Content="Recuperação de configurações" />
                </ComboBox></StackPanel>
                <Button x:Name="ClearFiltersButton" Visibility="Collapsed" Content="Limpar filtros" Height="36" Padding="16,5" VerticalAlignment="Bottom" Style="{StaticResource NexusActionButton}" Click="ClearFilters_Click" />
            </WrapPanel>
            <Button x:Name="NewActivity" Content="Novas atividades · Atualizar" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource NexusActionButton}" Click="Refresh_Click" />
        </StackPanel>
        <Grid Grid.Row="3">
            <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.ScrollChanged="Entries_ScrollChanged"
                     ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource ActivityCard}">
                <ListBox.Template><ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="False" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Margin="0,0,16,0" />
                    </ScrollViewer>
                </ControlTemplate></ListBox.Template>
                <ListBox.ItemTemplate><DataTemplate><Expander IsExpanded="False" HorizontalContentAlignment="Stretch" Style="{StaticResource ActivityExpander}" AutomationProperties.Name="{Binding Title}"><Expander.Header><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Info24" />
                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.AccountSwitched}"><Setter Property="Symbol" Value="People24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.AccountSwitchFailed}"><Setter Property="Symbol" Value="People24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameStarted}"><Setter Property="Symbol" Value="XboxController24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameLaunchFailed}"><Setter Property="Symbol" Value="XboxController24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.PreferenceRepaired}"><Setter Property="Symbol" Value="Wrench24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.RepairFailed}"><Setter Property="Symbol" Value="Wrench24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.UpdateReady}"><Setter Property="Symbol" Value="ArrowDownload24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.UpdateFailed}"><Setter Property="Symbol" Value="ArrowDownload24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.SettingsRecovered}"><Setter Property="Symbol" Value="History24" /></DataTrigger>
                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid></Expander.Header>
                <TextBlock Text="{Binding Detail}" Margin="38,12,0,0" FontSize="13" LineHeight="20" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                </Expander></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Text="Nenhuma operação registrada." TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,16,0">
            <Button x:Name="LoadMore" Content="Carregar mais 30" HorizontalAlignment="Center" Style="{StaticResource NexusActionButton}" Click="LoadMore_Click" Visibility="Collapsed" />
            <TextBlock x:Name="EndNotice" Text="Todos os registros carregados" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" Visibility="Collapsed" />
            <Button x:Name="TopButton" HorizontalAlignment="Right" Visibility="Collapsed" ToolTip="Voltar ao topo" AutomationProperties.Name="Voltar ao topo" Style="{StaticResource ActivityAction}" Click="Top_Click"><ui:SymbolIcon Symbol="ArrowUp24" FontSize="18" /></Button>
        </Grid>
    </Grid>
</Page>
