<Page x:Class="SteamSwitcher.Views.Pages.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SteamSwitcher.Views.Controls"
      xmlns:core="clr-namespace:SteamSwitcher.Core.Services;assembly=SteamSwitcher.Core"
      Title="Atividade recente"
      Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteamSwitcher;component/Themes/InteractionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="ActivityAction" TargetType="Button" BasedOn="{StaticResource NexusActionButton}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            </Style>

        <Style x:Key="FloatingTopButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexusKeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21" Width="42" Height="42">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource AppAccentAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FabBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiCardButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexusKeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityCard" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexusKeyboardFocus}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Linha vertical contínua da timeline -->
                            <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                       Fill="{DynamicResource AppBorderBrush}" Margin="0,-4,0,-14" SnapsToDevicePixels="True" />

                            <!-- Marcador / Nó da timeline -->
                            <Border x:Name="TimelineNode" Grid.Column="0" Width="14" Height="14" CornerRadius="7"
                                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,21,0,0"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="3"
                                    Panel.ZIndex="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.35" Color="#000000" />
                                </Border.Effect>
                            </Border>

                            <!-- Superfície do Card -->
                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource AppSurfaceBrush}"
                                    HorizontalAlignment="Stretch" x:Name="CardSurface">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                                <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource AppAccentAltBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                                <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameStarted}">
                                <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel HorizontalAlignment="Stretch">
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" FocusVisualStyle="{StaticResource NexusKeyboardFocus}"
                                          AutomationProperties.Name="{Binding Title}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,2" HorizontalAlignment="Stretch">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                              Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="28,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Atividade recente" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="StorageNotice" Text="Últimas 200 operações salvas neste computador. Sem senhas ou chaves."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="ExportStatusText" Text="Copiado para a área de transferência!" Foreground="{DynamicResource AppSuccessBrush}"
                               FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Style="{DynamicResource NexusActionButton}" Click="Export_Click"
                        ToolTip="Copiar todo o histórico filtrado para a área de transferência" Height="38" Padding="12,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Exportar" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActivityAction}" Click="Monitoring_Click" ToolTip="Medições do monitoramento" AutomationProperties.Name="Medições do monitoramento">
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ActivityAction}" Click="Refresh_Click" ToolTip="Atualizar histórico" AutomationProperties.Name="Atualizar histórico">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                </Button>
                <Button x:Name="ClearButton" Style="{StaticResource ActivityAction}" Click="Clear_Click" ToolTip="Limpar histórico salvo" AutomationProperties.Name="Limpar histórico salvo">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- KPIs Strip -->
        <!-- KPIs Strip (Compact) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total -->
            <Button Grid.Column="0" Style="{StaticResource KpiCardButton}" Click="KpiTotal_Click" ToolTip="Clique para ver todos os registros">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,8,0">
                        <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiTotalText" Text="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Trocas -->
            <Button Grid.Column="2" Style="{StaticResource KpiCardButton}" Click="KpiSwitches_Click" ToolTip="Filtrar por trocas de conta">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AppAccentSurfaceBrush}" Margin="0,0,8,0">
                        <ui:SymbolIcon Symbol="People24" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Trocas de Conta" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiSwitchesText" Text="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Jogos -->
            <Button Grid.Column="4" Style="{StaticResource KpiCardButton}" Click="KpiGames_Click" ToolTip="Filtrar por inícios de jogo">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AppSuccessSurfaceBrush}" Margin="0,0,8,0">
                        <ui:SymbolIcon Symbol="XboxController24" FontSize="14" Foreground="{DynamicResource AppSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Jogos Iniciados" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiGamesText" Text="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppSuccessBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Falhas / Atenção -->
            <Button Grid.Column="6" x:Name="KpiAttentionCard" Style="{StaticResource KpiCardButton}" Click="KpiAttention_Click" ToolTip="Filtrar por registros que exigem atenção">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KpiAttentionIconBorder" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,8,0">
                        <ui:SymbolIcon x:Name="KpiAttentionIcon" Symbol="Warning24" FontSize="14" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Atenção / Falhas" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock x:Name="KpiAttentionText" Text="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <!-- Barra de Filtros Compacta e Alinhada -->
        <Border Grid.Row="2" Margin="0,0,0,14" Padding="12,10" CornerRadius="10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <!-- Search Input -->
                    <ui:TextBox x:Name="SearchBox" Width="220" Height="34" Margin="0,0,8,0"
                                PlaceholderText="Buscar conta, jogo, detalhe..." TextChanged="SearchBox_TextChanged">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Period Picker -->
                    <controls:HistoryPeriodPicker x:Name="PeriodPicker" Margin="0,0,8,0" />

                    <!-- Type Filter -->
                    <ComboBox x:Name="TypeFilter" Width="185" Height="34" Margin="0,0,8,0"
                              SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Tipo de registro">
                        <ComboBoxItem Content="Todos os tipos" />
                        <ComboBoxItem Content="Troca de conta" />
                        <ComboBoxItem Content="Início de jogo" />
                        <ComboBoxItem Content="Correção da Steam" />
                        <ComboBoxItem Content="Atualização" />
                        <ComboBoxItem Content="Recuperação de configs" />
                        <ComboBoxItem Content="Somente falhas / atenção" />
                    </ComboBox>

                    <!-- Clear Filters Button -->
                    <Button x:Name="ClearFiltersButton" Visibility="Collapsed" Content="Limpar filtros" Height="34" Padding="12,0"
                            Margin="0,0,8,0" VerticalAlignment="Center" Style="{DynamicResource NexusActionButton}" Click="ClearFilters_Click" />

                    <!-- Preview Toggle (Debug) -->
                    <Button x:Name="PreviewToggle" Visibility="Collapsed" Content="Sair da prévia" Height="34" Padding="12,0"
                            Margin="0,0,8,0" VerticalAlignment="Center" Style="{DynamicResource NexusActionButton}" Click="Preview_Click" />
                </WrapPanel>

                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="Summary" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" />
                    <Button x:Name="NewActivity" Content="Novas atividades · Clique para atualizar" Visibility="Collapsed"
                            HorizontalAlignment="Right" Style="{DynamicResource NexusActionButton}" Height="28" Padding="10,0" Click="Refresh_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Entries List Container -->
        <Grid Grid.Row="3">
            <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.ScrollChanged="Entries_ScrollChanged"
                     ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource ActivityCard}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="False" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter Margin="0,0,8,0" HorizontalAlignment="Stretch" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Style="{StaticResource ActivityExpander}" AutomationProperties.Name="{Binding Title}">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Info24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.AccountSwitched}">
                                                            <Setter Property="Symbol" Value="People24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.AccountSwitchFailed}">
                                                            <Setter Property="Symbol" Value="People24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameStarted}">
                                                            <Setter Property="Symbol" Value="XboxController24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.GameLaunchFailed}">
                                                            <Setter Property="Symbol" Value="XboxController24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.PreferenceRepaired}">
                                                            <Setter Property="Symbol" Value="Wrench24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.RepairFailed}">
                                                            <Setter Property="Symbol" Value="Wrench24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.UpdateReady}">
                                                            <Setter Property="Symbol" Value="ArrowDownload24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentAltBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.UpdateFailed}">
                                                            <Setter Property="Symbol" Value="ArrowDownload24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ActivityKind.SettingsRecovered}">
                                                            <Setter Property="Symbol" Value="History24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Border>

                                    <!-- Title & Context -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Status Badge (apenas exibido quando exige atenção/falha) -->
                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{DynamicResource AppDangerSurfaceBrush}"
                                                    BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                                                    Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Falha" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppDangerBrush}" />
                                            </Border>
                                        </WrapPanel>

                                        <!-- Subtitle (Account Transition / Game Name / Operation) -->
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Far Right: Relative Time, Copy Button (Hover) and Chevron -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RelativeTime}" ToolTip="{Binding TimeText}"
                                                   FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <Button Width="28" Height="28"
                                                PreviewMouseLeftButtonDown="CopyButton_PreviewMouseLeftButtonDown"
                                                Tag="{Binding}" Margin="0,0,6,0" ToolTip="Copiar detalhes deste registro">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource NexusSidebarAction}">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                                        </Button>

                                        <Border Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="M0,0 L5,5 10,0" Stroke="{DynamicResource AppTextSecondaryBrush}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <!-- Expanded Details Panel -->
                            <Border Margin="50,12,0,4" Padding="16,14" CornerRadius="10"
                                    Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <!-- Header row with metadata badges and copy button -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Metadata Badges -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TimeText, StringFormat='Registrado em {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,0,8,0"
                                                    Visibility="{Binding HasInstallation, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="13" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Installation, StringFormat='Steam: {0}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Action: Copy details -->
                                        <Button Grid.Column="1" Style="{DynamicResource NexusActionButton}" Height="30" Padding="10,0"
                                                PreviewMouseLeftButtonDown="CopyButton_PreviewMouseLeftButtonDown" Tag="{Binding}"
                                                ToolTip="Copiar detalhes completos deste registro">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Copiar dados" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Account Transition Visual Flow (when IsAccountSwitch == true) -->
                                    <Grid Margin="0,0,0,10" Visibility="{Binding IsAccountSwitch, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Origem -->
                                        <Border Grid.Column="0" Padding="14,12" CornerRadius="8"
                                                Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AppChromeBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="CONTA DE ORIGEM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" />
                                                    <TextBlock Text="{Binding DisplaySourceAccount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Arrow Indicator -->
                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Margin="10,0"
                                                Background="{DynamicResource AppAccentSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="15" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Destino -->
                                        <Border Grid.Column="2" Padding="14,12" CornerRadius="8"
                                                Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AppAccentSurfaceBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="CONTA DE DESTINO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                                    <TextBlock Text="{Binding DisplayTargetAccount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Game Launch Visual (when IsGame == true) -->
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8"
                                            Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding IsGame, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AppSuccessSurfaceBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="XboxController24" FontSize="20" Foreground="{DynamicResource AppSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="JOGO REGISTRADO NA SESSÃO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" />
                                                <TextBlock Text="{Binding Subject}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DisplayTargetAccount, StringFormat='Conta ativa: {0}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0"
                                                           Visibility="{Binding HasTransition, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Repair Visual (when IsRepair == true) -->
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8"
                                            Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding IsRepair, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AppWarningSurfaceBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Foreground="{DynamicResource AppWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="CONFIGURAÇÃO AUTOMÁTICA DA STEAM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" />
                                                <TextBlock Text="{Binding Operation}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DisplayTargetAccount, StringFormat='Conta / Instalação: {0}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- General / Other Visual (when IsGeneral == true) -->
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8"
                                            Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" LineHeight="18" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Failure Alert Banner (when NeedsAttention == true) -->
                                    <Border Margin="0,2,0,0" Padding="14,12" CornerRadius="8"
                                            Background="{DynamicResource AppDangerSurfaceBrush}" BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                                            Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AppDangerBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Warning24" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="OPERAÇÃO NÃO CONCLUÍDA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}" />
                                                <TextBlock Text="{Binding FailureReason}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Click="GoToDiagnostics_Click" Style="{DynamicResource NexusActionButton}"
                                                    Height="32" Padding="12,0" Margin="12,0,0,0" ToolTip="Ver ferramentas de diagnóstico da Steam">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Diagnóstico" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Success Confirmation Banner (when NeedsAttention == false) -->
                                    <Border Margin="0,2,0,0" Padding="12,8" CornerRadius="6"
                                            Background="{DynamicResource AppSuccessSurfaceBrush}" BorderBrush="{DynamicResource AppSuccessBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Operação concluída com sucesso pelo SteamNexus." FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Search24" FontSize="44" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="Empty" Text="Nenhum registro encontrado." FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Ajuste os termos de busca, o período ou limpe os filtros." FontSize="12"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12" />
                <Button Content="Limpar filtros" HorizontalAlignment="Center" Style="{DynamicResource NexusActionButton}" Click="ClearFilters_Click" />
            </StackPanel>

            <!-- Floating Back-to-Top Button -->
            <Button x:Name="TopButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,20"
                    Width="42" Height="42"
                    Visibility="Collapsed"
                    ToolTip="Voltar ao topo"
                    AutomationProperties.Name="Voltar ao topo"
                    Style="{StaticResource FloatingTopButton}"
                    Click="Top_Click">
                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="18" />
            </Button>
        </Grid>

        <!-- End Notice Footer -->
        <TextBlock Grid.Row="4" x:Name="EndNotice" Text="Todos os registros carregados"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                   FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Visibility="Collapsed" />
    </Grid>
</Page>
