<Page
    x:Class="SteamSwitcher.Views.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:vm="clr-namespace:SteamSwitcher.ViewModels"
    xmlns:services="clr-namespace:SteamSwitcher.Core.Services;assembly=SteamSwitcher.Core"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters"
    >

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border
            Grid.Row="0"
            Padding="20,16,20,12"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppChromeBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        Text="Modificações detectadas"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock
                        Text="Monitoramento em tempo real de plugins, skins e patches"
                        FontSize="12"
                        Foreground="{DynamicResource AppTextMutedBrush}"
                        Margin="0,2,0,0" />
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    Padding="12,6"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Reatualizar detecção">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="ArrowSync" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Grid.Column="3"
                    Padding="12,6"
                    Appearance="Danger"
                    Command="{Binding ReinstallCleanSteamCommand}"
                    Visibility="{Binding HasSuspicious, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Remove tudo e reinstala o Steam, preservando suas contas">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="ShieldError" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Reinstalar Steam limpo" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Banner suspeito -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource AppDangerSurfaceBrush}"
            BorderBrush="{DynamicResource AppDangerBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,10"
            Visibility="{Binding HasSuspicious, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ic:SymbolIcon
                    Symbol="Warning"
                    IconVariant="Filled"
                    Foreground="{DynamicResource AppDangerBrush}"
                    FontSize="16"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center" />
                <TextBlock
                    Foreground="{DynamicResource AppDangerBrush}"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Modificações suspeitas detectadas. Arquivos executáveis encontrados em pastas não esperadas." />
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="2">

            <!-- Lista agrupada -->
            <ScrollViewer
                Padding="20"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModGroup}">
                            <Border Margin="0,0,0,12">
                                <StackPanel>

                                    <!-- Header do grupo (clicável) -->
                                    <Border
                                        CornerRadius="10"
                                        Padding="14,11"
                                        Cursor="Hand"
                                        Margin="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSuspicious}" Value="True">
                                                        <Setter Property="Background" Value="#2A1215" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="CornerRadius" Value="10,10,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                Command="{Binding ToggleCommand}" />
                                        </Border.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Ícone do tipo -->
                                            <ic:SymbolIcon
                                                Grid.Column="0"
                                                FontSize="18"
                                                VerticalAlignment="Center">
                                                <ic:SymbolIcon.Style>
                                                    <Style TargetType="ic:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Apps" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}"
                                                                Value="{x:Static services:ModType.Skin}">
                                                                <Setter Property="Symbol" Value="PaintBrush" />
                                                                <Setter Property="Foreground" Value="#B07AFF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}"
                                                                Value="{x:Static services:ModType.Plugin}">
                                                                <Setter Property="Symbol" Value="PlugConnected" />
                                                                <Setter Property="Foreground" Value="#4B9EFF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}"
                                                                Value="{x:Static services:ModType.Patcher}">
                                                                <Setter Property="Symbol" Value="Wrench" />
                                                                <Setter Property="Foreground" Value="#F2B84B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}"
                                                                Value="{x:Static services:ModType.Millennium}">
                                                                <Setter Property="Symbol" Value="Star" />
                                                                <Setter Property="Foreground" Value="#38D6C6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasSuspicious}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ic:SymbolIcon.Style>
                                            </ic:SymbolIcon>

                                            <!-- Título + contagem -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding Title}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            </StackPanel>

                                            <!-- Badge suspeito -->
                                            <Border
                                                Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,8,0"
                                                Background="{DynamicResource AppDangerSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppDangerBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasSuspicious,
                                                    Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ic:SymbolIcon
                                                        Symbol="Warning"
                                                        IconVariant="Filled"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource AppDangerBrush}"
                                                        Margin="0,0,4,0" />
                                                    <TextBlock
                                                        Text="Suspeito"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource AppDangerBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Contador de itens -->
                                            <Border
                                                Grid.Column="3"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding Count}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            </Border>

                                            <!-- Chevron -->
                                            <ic:SymbolIcon
                                                Grid.Column="4"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AppTextMutedBrush}">
                                                <ic:SymbolIcon.Style>
                                                    <Style TargetType="ic:SymbolIcon">
                                                        <Setter Property="Symbol" Value="ChevronDown" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                <Setter Property="Symbol" Value="ChevronRight" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ic:SymbolIcon.Style>
                                            </ic:SymbolIcon>
                                        </Grid>
                                    </Border>

                                    <!-- Itens do grupo (colapsável) -->
                                    <Border
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,10,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        Visibility="{Binding IsExpanded,
                                            Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:DetectedMod}">
                                                    <Border
                                                        Padding="14,10"
                                                        BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AppBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSuspicious}"
                                                                        Value="True">
                                                                        <Setter Property="Background"
                                                                            Value="#1A0D0D" />
                                                                        <Setter Property="BorderBrush"
                                                                            Value="Transparent" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Ícone arquivo/pasta -->
                                                            <ic:SymbolIcon
                                                                Grid.Column="0"
                                                                FontSize="15"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource AppTextMutedBrush}">
                                                                <ic:SymbolIcon.Style>
                                                                    <Style TargetType="ic:SymbolIcon">
                                                                        <Setter Property="Symbol" Value="Folder" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSuspicious}"
                                                                                Value="True">
                                                                                <Setter Property="Symbol"
                                                                                    Value="Warning" />
                                                                                <Setter Property="Foreground"
                                                                                    Value="{DynamicResource AppDangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ic:SymbolIcon.Style>
                                                            </ic:SymbolIcon>

                                                            <!-- Nome + path -->
                                                            <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Margin="4,0,0,0">
                                                                <TextBlock
                                                                    Text="{Binding Name}"
                                                                    FontSize="13"
                                                                    FontWeight="Medium"
                                                                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                                <TextBlock
                                                                    Text="{Binding Path}"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource AppTextMutedBrush}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Margin="0,2,0,0"
                                                                    ToolTip="{Binding Path}" />
                                                            </StackPanel>

                                                            <!-- Badge suspeito no item -->
                                                            <Border
                                                                Grid.Column="2"
                                                                CornerRadius="6"
                                                                Padding="7,3"
                                                                Background="{DynamicResource AppDangerSurfaceBrush}"
                                                                BorderBrush="{DynamicResource AppDangerBrush}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsSuspicious,
                                                                    Converter={StaticResource BoolToVisibility}}"
                                                                ToolTip="Arquivo executável em pasta inesperada">
                                                                <TextBlock
                                                                    Text="Suspeito"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource AppDangerBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
            </Grid>

            <!-- Empty state -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <ic:SymbolIcon
                    Symbol="CheckmarkCircle"
                    IconVariant="Filled"
                    FontSize="64"
                    Foreground="{DynamicResource AppSuccessBrush}"
                    Opacity="0.5"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Nenhuma modificação detectada"
                    FontSize="18"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    Opacity="0.6"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,8" />
                <TextBlock
                    Text="O Steam está limpo."
                    Foreground="{DynamicResource AppTextMutedBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>