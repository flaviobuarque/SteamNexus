<Page
    x:Class="SteamSwitcher.Views.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:vm="clr-namespace:SteamSwitcher.ViewModels"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters"
    xmlns:local="clr-namespace:SteamSwitcher.Views.Controls"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:PathToImageSourceConverter x:Key="PathToImageSource" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <Style x:Key="StoppedGameOnlyMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource AppCardMenuItemStyle}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="ToolTip" Value="Pare o jogo para acessar mais opções." />
                </DataTrigger>
                <DataTrigger Binding="{Binding RuntimeUncertain}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="Confirme que o jogo foi parado antes de continuar." />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="Aguarde a operação atual terminar." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GameContextMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource AppCardContextMenuStyle}">
            <Style.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource StoppedGameOnlyMenuItemStyle}" />
                <Style TargetType="Separator">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Margin="8,4" Background="{DynamicResource AppBorderBrush}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="GameFavoriteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6" /></Trigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="#F2B84B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSurfaceBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar fixa -->
        <Border
            Grid.Row="0"
            x:Name="Toolbar"
            Padding="20,14,20,14"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="Buscar jogo..."
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
                <Grid Grid.Column="2">
                    <ToggleButton
                        x:Name="AccountFilterButton"
                        MinWidth="220"
                        Style="{StaticResource AccountFilterToggleStyle}"
                        IsChecked="{Binding IsAccountFilterOpen, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="24" Height="24"
                                Margin="0,0,9,0" VerticalAlignment="Center">
                                <Image Source="{Binding SelectedFilterAccount.AvatarImage}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding SelectedFilterAccount.HasAvatar,
                                           Converter={StaticResource BoolToVisibility}}">
                                    <Image.Clip>
                                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                                    </Image.Clip>
                                </Image>
                                <ic:SymbolIcon FontSize="16">
                                    <ic:SymbolIcon.Style>
                                        <Style TargetType="ic:SymbolIcon">
                                            <Setter Property="Symbol" Value="Person" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterAccount.SteamId64}" Value="">
                                                    <Setter Property="Symbol" Value="People" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedFilterAccount.HasAvatar}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ic:SymbolIcon.Style>
                                </ic:SymbolIcon>
                            </Grid>
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFilterAccount.DisplayName}"
                                FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <ui:SymbolIcon Grid.Column="2" FontSize="14" Margin="9,0,0,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronDown20" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAccountFilterOpen}" Value="True">
                                                <Setter Property="Symbol" Value="ChevronUp20" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </ToggleButton>

                    <Popup
        PlacementTarget="{Binding ElementName=AccountFilterButton}"
        Placement="Bottom"
        StaysOpen="False"
        AllowsTransparency="True"
        IsOpen="{Binding IsAccountFilterOpen, Mode=TwoWay}">

                        <Border
            Width="320"
            Margin="0,6,0,0"
            Padding="10"
            CornerRadius="10"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Filtrar por conta"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                                    Margin="4,1,0,0" />

                                <ui:TextBox
                    Grid.Row="2"
                                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    PlaceholderText="Buscar conta..."
                    Text="{Binding FilterAccountSearchText,
                        UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Search24" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>

                                <ListBox
                                    Grid.Row="4"
                                    MaxHeight="280"
                                    ItemsSource="{Binding VisibleFilterAccounts}"
                                    SelectedItem="{Binding SelectedFilterAccount, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.CanContentScroll="True"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling"
                                    VirtualizingPanel.CacheLength="1"
                                    VirtualizingPanel.CacheLengthUnit="Page">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemRoot"
                                                            Background="Transparent"
                                                            CornerRadius="7">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemRoot" Property="Background"
                                                                    Value="{DynamicResource AppSurfaceHoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemRoot" Property="Background"
                                                                    Value="{DynamicResource AppAccentSurfaceBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                    Padding="10,8"
                                    Cursor="Hand"
                                    CornerRadius="6">

                                                    <Border.InputBindings>
                                                        <MouseBinding
                                            MouseAction="LeftClick"
                                            Command="{Binding DataContext.SelectGameFilterAccountCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                                    </Border.InputBindings>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="24" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="24" Height="24"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                            <Image Source="{Binding AvatarImage}"
                                                                   Stretch="UniformToFill"
                                                                   Visibility="{Binding HasAvatar,
                                                                       Converter={StaticResource BoolToVisibility}}">
                                                                <Image.Clip>
                                                                    <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                                                                </Image.Clip>
                                                            </Image>
                                                            <ic:SymbolIcon FontSize="16">
                                                                <ic:SymbolIcon.Style>
                                                                    <Style TargetType="ic:SymbolIcon">
                                                                        <Setter Property="Symbol" Value="Person" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SteamId64}" Value="">
                                                                                <Setter Property="Symbol" Value="People" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ic:SymbolIcon.Style>
                                                            </ic:SymbolIcon>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding AccountName}"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        </StackPanel>
                                                        <ic:SymbolIcon Grid.Column="2" Symbol="Checkmark" FontSize="14"
                                                            Foreground="{DynamicResource AppAccentBrush}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <ic:SymbolIcon.Style>
                                                                <Style TargetType="ic:SymbolIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected,
                                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                            Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ic:SymbolIcon.Style>
                                                        </ic:SymbolIcon>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <ui:Button Grid.Column="4" Width="36" Height="34" Padding="0"
                    ToolTip="Mostrar somente favoritos"
                    Appearance="Secondary"
                    Command="{Binding ToggleFavoritesFilterCommand}">
                    <ic:SymbolIcon Symbol="Star" FontSize="16">
                        <ic:SymbolIcon.Style>
                            <Style TargetType="ic:SymbolIcon">
                                <Setter Property="IconVariant" Value="Regular" />
                                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                        <Setter Property="IconVariant" Value="Filled" />
                                        <Setter Property="Foreground" Value="#F59E0B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ic:SymbolIcon.Style>
                    </ic:SymbolIcon>
                </ui:Button>

                <Border
                    Grid.Column="6"
                    Padding="2"
                    CornerRadius="8"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Width="34" Height="32" Padding="0"
                            ToolTip="Visualização em grade"
                            Command="{Binding ShowGameGridViewCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameGridView}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon Symbol="Grid24" />
                        </ui:Button>
                        <ui:Button Width="34" Height="32" Padding="0"
                            ToolTip="Visualização compacta"
                            Command="{Binding ShowGameCompactViewCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompactView}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon Symbol="List24" />
                        </ui:Button>
                    </StackPanel>
                </Border>

                <ui:Button
                    Grid.Column="8"
                    Padding="12,7"
                    Appearance="Secondary"
                    ToolTip="Alterar ordenação dos jogos"
                    Click="GameSortButton_Click">
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSort24" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding GameSortLabel}" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ChevronDown20" Margin="7,0,0,0" />
                        </StackPanel>
                    </ui:Button.Content>
                    <ui:Button.ContextMenu>
                        <ContextMenu
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" Padding="4"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType">
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.SortGamesAlphabeticallyCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <Grid Width="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Nome: A–Z" VerticalAlignment="Center" />
                                        <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                            Foreground="{DynamicResource AppAccentBrush}"
                                            Visibility="{Binding PlacementTarget.DataContext.IsAlphabeticalGameSort,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </MenuItem.Header>
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="TextSortAscending24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.SortGamesByRecentlyPlayedCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <Grid Width="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Uso Recente" VerticalAlignment="Center" />
                                        <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                            Foreground="{DynamicResource AppAccentBrush}"
                                            Visibility="{Binding PlacementTarget.DataContext.IsRecentlyPlayedGameSort,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </MenuItem.Header>
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Clock24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.SortGamesByMostPlayedCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <Grid Width="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mais jogados" VerticalAlignment="Center" />
                                        <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                            Foreground="{DynamicResource AppAccentBrush}"
                                            Visibility="{Binding PlacementTarget.DataContext.IsMostPlayedGameSort,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </MenuItem.Header>
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="History24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.SortGamesByLargestSizeCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <Grid Width="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Maior tamanho" VerticalAlignment="Center" />
                                        <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" FontSize="14"
                                            Foreground="{DynamicResource AppAccentBrush}"
                                            Visibility="{Binding PlacementTarget.DataContext.IsLargestSizeGameSort,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </MenuItem.Header>
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="HardDrive24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,10,20,0"
            Visibility="{Binding HasPendingUninstall, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="0,0,0,8" Visibility="{Binding HasPendingUninstall, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Content="Já cancelei na Steam" Margin="12,0,0,0" HorizontalAlignment="Right"
                    Command="{Binding AcknowledgeUninstallCancellationCommand}"
                    Visibility="{Binding HasPendingUninstall, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </StackPanel>

        <!-- Conteúdo -->
        <Grid Grid.Row="2">
            <ItemsControl
                x:Name="GamesItemsControl"
                Padding="12"
                ItemsSource="{Binding Games}"
                ClipToBounds="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding IsGameGridContentVisible, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer
                            CanContentScroll="True"
                            IsDeferredScrollingEnabled="False"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="{TemplateBinding Padding}"
                            Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel
                            ItemSize="{Binding GameGridItemSize}"
                            SpacingMode="{Binding GameGridSpacingMode}"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                            <Grid>
                                <Grid.LayoutTransform>
                                    <ScaleTransform
                                        ScaleX="{Binding DataContext.GameCardScale, Source={x:Reference GamesItemsControl}}"
                                        ScaleY="{Binding DataContext.GameCardScale, Source={x:Reference GamesItemsControl}}" />
                                </Grid.LayoutTransform>
                            <Border Width="160" Height="340" Margin="0,0,10,10"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppSurfaceBrush}"
                                Effect="{DynamicResource AppCardEffect}" IsHitTestVisible="False" />
                            <Border
                                x:Name="CardRoot"
                                UseLayoutRounding="True" SnapsToDevicePixels="True"
                                TextOptions.TextFormattingMode="Display"
                                Width="160"
                                Height="340"
                                Margin="0,0,10,10"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                BorderThickness="1"
                                Background="{DynamicResource AppSurfaceBrush}"
                                Cursor="Hand"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                             To="-3" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                             To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource GameContextMenuStyle}">
                                        <MenuItem Header="Pare o jogo para acessar mais opções."
                                            Style="{StaticResource AppCardMenuItemStyle}" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                            IsEnabled="False"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ToggleGameFavoriteCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource AppCardMenuItemStyle}">
                                                    <Setter Property="Header" Value="Adicionar aos favoritos" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Header" Value="Remover dos favoritos" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                            <MenuItem.Icon><ic:SymbolIcon Symbol="Star" Foreground="#F2B84B" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem
                                            Header="Alterar conta do jogo"
                                            Style="{StaticResource StoppedGameOnlyMenuItemStyle}"
                                            Command="{Binding PlacementTarget.Tag.ChangeGameAccountCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ic:SymbolIcon Symbol="ArrowSwap" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Header="Status ao entrar..."
                                            Command="{Binding PlacementTarget.Tag.ChangeGameLoginStateCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ic:SymbolIcon Symbol="PresenceAvailable" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Header="Adicionar capa..."
                                            Command="{Binding PlacementTarget.Tag.AddCoverCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ic:SymbolIcon Symbol="Image" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Header="Remover capa manual"
                                            Command="{Binding PlacementTarget.Tag.RemoveManualCoverCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ic:SymbolIcon Symbol="ImageOff" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Desinstalar…"
                                            Style="{StaticResource StoppedGameOnlyMenuItemStyle}"
                                            Command="{Binding PlacementTarget.Tag.UninstallGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="4,42,4,0"
                                        Background="{DynamicResource AppChromeBrush}" CornerRadius="6" Padding="6,3" Panel.ZIndex="22">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RuntimeStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RuntimeStatus}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="138">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding RuntimeUncertain}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource GameFavoriteIconButtonStyle}"
                                        Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Panel.ZIndex="20" ToolTip="Favoritar jogo"
                                        Command="{Binding DataContext.ToggleGameFavoriteCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                        <ic:SymbolIcon Symbol="Star" FontSize="15">
                                            <ic:SymbolIcon.Style>
                                                <Style TargetType="ic:SymbolIcon">
                                                    <Setter Property="IconVariant" Value="Regular" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="IconVariant" Value="Filled" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ic:SymbolIcon.Style>
                                        </ic:SymbolIcon>
                                    </Button>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="8,8,0,0" Panel.ZIndex="20">
                                        <!-- Badge 1: Conta proprietária (11px, SemiBold) -->
                                        <Border Padding="7,3" CornerRadius="6"
                                                Background="{DynamicResource AppChromeBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                ToolTip="{Binding OwnerAccountTooltip}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ic:SymbolIcon Symbol="Person" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppAccentBrush}"
                                                               Visibility="{Binding HasOwner, Converter={StaticResource BoolToVisibility}}" />
                                                <ic:SymbolIcon Symbol="PersonQuestionMark" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppTextMutedBrush}"
                                                               Visibility="{Binding HasOwner, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <TextBlock Text="{Binding OwnerAccountName}" FontSize="11" FontWeight="SemiBold" MaxWidth="90"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           Visibility="{Binding HasOwner, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="Sem conta" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                                           Visibility="{Binding HasOwner, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Badge 2: Modo Offline / Online (Empilhado logo abaixo) -->
                                        <Border Margin="0,4,0,0" Padding="7,2" CornerRadius="6"
                                                HorizontalAlignment="Left"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="GameLoginBadge_MouseLeftButtonUp"
                                                Visibility="{Binding HasCustomLoginPreference, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{Binding LoginPreferenceTooltip}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#123C2B" />
                                                    <Setter Property="BorderBrush" Value="#22C55E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustomOffline}" Value="True">
                                                            <Setter Property="Background" Value="#492B13" />
                                                            <Setter Property="BorderBrush" Value="#FB923C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCustomOnline}" Value="True">
                                                            <Setter Property="Background" Value="#123C2B" />
                                                            <Setter Property="BorderBrush" Value="#22C55E" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.85" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ic:SymbolIcon Symbol="GlobeOff" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"
                                                               Foreground="#FED7AA"
                                                               Visibility="{Binding IsCustomOffline, Converter={StaticResource BoolToVisibility}}" />
                                                <ic:SymbolIcon Symbol="Globe" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"
                                                               Foreground="#86EFAC"
                                                               Visibility="{Binding IsCustomOnline, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding CustomLoginBadgeLabel}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#86EFAC" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCustomOffline}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FED7AA" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCustomOnline}" Value="True">
                                                                    <Setter Property="Foreground" Value="#86EFAC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- 2. Capa do jogo -->
                                    <Border
                                        CornerRadius="14,14,0,0"
                                        Height="240"
                                        VerticalAlignment="Top"
                                        ClipToBounds="True">
                                        <Grid>
                                            <Image
                                                Source="{Binding CoverImage}"
                                                Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,160,240" RadiusX="14" RadiusY="14" />
                                                </Image.Clip>
                                            </Image>
                                            <Border
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                CornerRadius="14,14,0,0"
                                                Visibility="{Binding CoverPath,
                                                    Converter={StaticResource EmptyStringToVisibility}}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <ic:SymbolIcon
                                                    Symbol="Games" FontSize="40"
                                                    Foreground="{DynamicResource AppTextMutedBrush}"
                                                    HorizontalAlignment="Center">
                                                    <ic:SymbolIcon.Style>
                                                        <Style TargetType="ic:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CoverMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCoverLoading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ic:SymbolIcon.Style>
                                                </ic:SymbolIcon>
                                                <local:BusyRing
                                                    Width="30"
                                                    Height="30"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding IsCoverLoading,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                                <ic:SymbolIcon
                                                    Symbol="ImageOff" FontSize="32"
                                                    Foreground="{DynamicResource AppWarningBrush}"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding CoverMissing,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    Text="Sem capa" FontSize="10"
                                                    Foreground="{DynamicResource AppWarningBrush}"
                                                    HorizontalAlignment="Center" Margin="0,6,0,0"
                                                    Visibility="{Binding CoverMissing,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    Text="Adicione pelo menu de contexto do jogo, ou configure uma API key."
                                                    FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"
                                                    HorizontalAlignment="Center" TextAlignment="Center"
                                                    TextWrapping="Wrap" Margin="8,4,8,0"
                                                    Visibility="{Binding CoverMissing,
                                                        Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 3. Overlay hover com botão -->
                                    <Border Height="240" VerticalAlignment="Top" CornerRadius="14,14,0,0"
                                        Background="{DynamicResource AppSuccessBrush}" Opacity="0.12" IsHitTestVisible="False"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <Border
                                        x:Name="HoverOverlay"
                                        CornerRadius="14,14,0,0"
                                        Height="240"
                                        VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border
                                            Background="{DynamicResource AppOverlayBrush}"
                                            CornerRadius="14,14,0,0">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <ui:Button
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Padding="16,8"
                                                        Command="{Binding DataContext.LaunchGameCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                <Setter Property="Appearance" Value="Primary" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasOwner}" Value="False">
                                                                        <Setter Property="Appearance" Value="Secondary" />
                                                                    </DataTrigger>
                                                                    <DataTrigger
                                                                        Binding="{Binding DataContext.IsGameLaunchInProgress,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ic:SymbolIcon FontSize="13" Margin="0,0,6,0">
                                                                <ic:SymbolIcon.Style>
                                                                    <Style TargetType="ic:SymbolIcon">
                                                                        <Setter Property="Symbol" Value="Play" />
                                                                        <Setter Property="IconVariant" Value="Filled" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasOwner}" Value="False">
                                                                                <Setter Property="Symbol" Value="PersonAdd" />
                                                                                <Setter Property="IconVariant" Value="Regular" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Symbol" Value="Stop" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ic:SymbolIcon.Style>
                                                            </ic:SymbolIcon>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding PrimaryActionText}" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <TextBlock
                                                        Text="Conta desconhecida"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource AppTextMutedBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,0"
                                                        Visibility="{Binding HasOwner, Converter={StaticResource InverseBoolToVisibility}}" />
                                                </StackPanel>

                                                <Button Content="⋯" Width="28" Height="28" Padding="0" FontSize="18" FontWeight="Bold"
                                                    Margin="0,0,8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Cursor="Hand" ToolTip="Opções do jogo" AutomationProperties.Name="Opções do jogo"
                                                    Click="GameOptionsButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="{DynamicResource AppChromeBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="Opacity" Value="0.9" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <!-- 4. Overlay launching -->
                                    <Border
                                        Background="{DynamicResource AppOverlayBrush}"
                                        CornerRadius="14,14,0,0"
                                        Height="240"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                        <local:BusyRing Width="32" Height="32"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- 5. Área de texto / Rodapé -->
                                    <Border Margin="0,240,0,0" Padding="8,8,8,8">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Linha 0: Título com altura fixa de 34px (garante mesmo alinhamento com 1 ou 2 linhas) -->
                                            <TextBlock
                                                Grid.Row="0"
                                                Text="{Binding Game.Name}"
                                                FontSize="12" FontWeight="SemiBold"
                                                Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                MaxHeight="34"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Game.Name}" />

                                            <!-- Linha 1: Caixinha Ficha Técnica dividida lado a lado (Armazenamento à esquerda | Tempo à direita) -->
                                            <Border Grid.Row="1" Margin="0,8,0,0" Padding="4,5" CornerRadius="6"
                                                    Background="{DynamicResource AppChromeBrush}"
                                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.15*" />
                                                        <ColumnDefinition Width="1" />
                                                        <ColumnDefinition Width="0.85*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Coluna 0: Armazenamento (Disco e Tamanho) -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="2,0" ToolTip="{Binding InstallFullPath}">
                                                        <ic:SymbolIcon Symbol="HardDrive" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        <TextBlock Text="{Binding StorageDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Separador vertical -->
                                                    <Rectangle Grid.Column="1" Fill="{DynamicResource AppBorderBrush}" VerticalAlignment="Stretch" Margin="0,1" />

                                                    <!-- Coluna 2: Tempo de jogo -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="2,0" ToolTip="{Binding PlaytimeTooltip}">
                                                        <ic:SymbolIcon Symbol="Clock" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        <TextBlock Text="{Binding PlaytimeShortDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNeverPlayed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                    <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
                                    <Setter TargetName="CardRoot" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource AppSuccessSurfaceBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <ListBox
                Padding="0"
                ItemsSource="{Binding Games}"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.IsDeferredScrollingEnabled="False"
                ScrollViewer.PanningMode="VerticalOnly"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                Visibility="{Binding IsGameCompactContentVisible, Converter={StaticResource BoolToVisibility}}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly" Focusable="False">
                            <ItemsPresenter Margin="20,16,12,16" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,8"
                            CornerRadius="10"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource GameContextMenuStyle}">
                                    <MenuItem Header="Pare o jogo para acessar mais opções."
                                        Style="{StaticResource AppCardMenuItemStyle}" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        IsEnabled="False"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <MenuItem
                                        Command="{Binding PlacementTarget.Tag.ToggleGameFavoriteCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource AppCardMenuItemStyle}">
                                                <Setter Property="Header" Value="Adicionar aos favoritos" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Header" Value="Remover dos favoritos" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Alterar conta do jogo"
                                        Style="{StaticResource StoppedGameOnlyMenuItemStyle}"
                                        Command="{Binding PlacementTarget.Tag.ChangeGameAccountCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}" />
                                    <MenuItem Header="Status ao entrar..."
                                        Command="{Binding PlacementTarget.Tag.ChangeGameLoginStateCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}" />
                                    <MenuItem Header="Adicionar capa..."
                                        Command="{Binding PlacementTarget.Tag.AddCoverCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}" />
                                    <MenuItem Header="Remover capa manual"
                                        Command="{Binding PlacementTarget.Tag.RemoveManualCoverCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Desinstalar…"
                                        Style="{StaticResource StoppedGameOnlyMenuItemStyle}"
                                        Command="{Binding PlacementTarget.Tag.UninstallGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid Height="82">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource AppBackgroundBrush}">
                                    <Grid>
                                        <Image Source="{Binding CoverImage}" Stretch="Uniform" />
                                        <ic:SymbolIcon Symbol="Games" FontSize="20"
                                            Foreground="{DynamicResource AppTextMutedBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding CoverPath, Converter={StaticResource EmptyStringToVisibility}}" />
                                        <local:BusyRing Width="20" Height="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsCoverLoading, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Game.Name}" FontSize="13" FontWeight="SemiBold"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis" ToolTip="{Binding Game.Name}" />
                                    <TextBlock Text="{Binding RuntimeStatus}" FontSize="10"
                                        Foreground="{DynamicResource AppSuccessBrush}" Margin="0,3,0,0"
                                        Visibility="{Binding RuntimeStatus, Converter={StaticResource EmptyStringToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{Binding LoginPreferenceText}"
                                        local:LoginPreferenceMenu.Command="{Binding DataContext.SetGameLoginStateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        local:LoginPreferenceMenu.State="{Binding LoginPreferenceValue}"
                                        local:LoginPreferenceMenu.InheritedText="{Binding LoginPreferenceInheritedText}"
                                        Margin="0,0,10,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding InstallationName, StringFormat=Steam: {0}}" FontSize="10"
                                        Foreground="{DynamicResource AppAccentBrush}" Margin="0" VerticalAlignment="Center"
                                        ToolTip="{Binding InstallationRootPath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="Conta" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text="{Binding OwnerAccountName}" FontSize="11"
                                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding HasOwner, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Não associada" FontSize="11" FontStyle="Italic"
                                        Foreground="{DynamicResource AppTextMutedBrush}"
                                        Visibility="{Binding HasOwner, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="Tempo de jogo" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text="{Binding Game.PlaytimeFormatted}" FontSize="11"
                                        Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="Armazenamento" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text="{Binding SizeAndDrive, StringFormat=Jogo: {0}}" FontSize="11"
                                        Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="6" Style="{StaticResource GameFavoriteIconButtonStyle}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="Favoritar jogo"
                                    Command="{Binding DataContext.ToggleGameFavoriteCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                    <ic:SymbolIcon Symbol="Star" FontSize="15">
                                        <ic:SymbolIcon.Style>
                                            <Style TargetType="ic:SymbolIcon">
                                                <Setter Property="IconVariant" Value="Regular" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="IconVariant" Value="Filled" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ic:SymbolIcon.Style>
                                    </ic:SymbolIcon>
                                </Button>

                                <ui:Button Grid.Column="7" Width="36" Height="36" Padding="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding PrimaryActionText}"
                                    AutomationProperties.Name="{Binding PrimaryActionText}"
                                    Command="{Binding DataContext.LaunchGameCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOwner}" Value="False">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.IsGameLaunchInProgress,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <ic:SymbolIcon FontSize="16">
                                        <ic:SymbolIcon.Style>
                                            <Style TargetType="ic:SymbolIcon">
                                                <Setter Property="Symbol" Value="Play" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOwner}" Value="False">
                                                        <Setter Property="Symbol" Value="PersonAdd" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Symbol" Value="Stop" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ic:SymbolIcon.Style>
                                    </ic:SymbolIcon>
                                </ui:Button>
                                <Button Grid.Column="7" Content="⋯" Width="36" Height="36" Padding="0" FontSize="18"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="Opções do jogo" AutomationProperties.Name="Opções do jogo"
                                    Click="GameOptionsButton_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <local:BusyRing Width="48" Height="48" />
            </Grid>

            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding HasNoInstalledGames, Converter={StaticResource BoolToVisibility}}">
                <ic:SymbolIcon Symbol="Games" FontSize="64" Opacity="0.55"
                    Foreground="{DynamicResource AppTextSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock Text="Nenhum jogo instalado" FontSize="18" Foreground="{DynamicResource AppTextSecondaryBrush}"
                    HorizontalAlignment="Center" Margin="0,16,0,8" />
                <TextBlock Text="Instale um jogo pela Steam; a biblioteca será atualizada automaticamente."
                    Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVisibility}}">
                <ic:SymbolIcon Symbol="Search" FontSize="56" Opacity="0.55"
                    Foreground="{DynamicResource AppTextSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock Text="Nenhum jogo corresponde aos filtros"
                    FontSize="18" Foreground="{DynamicResource AppTextSecondaryBrush}"
                    HorizontalAlignment="Center" Margin="0,16,0,8" />
                <TextBlock Text="Tente outro nome ou selecione todas as contas."
                    Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" />
                <ui:Button
                    Content="Limpar filtros"
                    Appearance="Secondary"
                    Command="{Binding ClearGameFiltersCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
