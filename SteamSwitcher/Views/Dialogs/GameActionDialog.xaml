<Window x:Class="SteamSwitcher.Views.Dialogs.GameActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:SteamSwitcher.Views.Controls"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
    Width="800" Height="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="#AA000000">
        <Border Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24" Margin="16"
            MaxWidth="520" MaxHeight="580" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"
                            Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="SourceHeading" Text="Em execução" FontWeight="SemiBold" Margin="0,0,0,8"
                            Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <ItemsControl x:Name="SourceGames">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <Image Source="{Binding CoverImage}" Width="36" Height="50" Stretch="UniformToFill" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Game.Name}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding RuntimeAccountName}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Margin="0,4,0,14">
                            <DockPanel>
                                <Image x:Name="DestinationCover" Width="42" Height="60" Stretch="UniformToFill" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Você vai abrir" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock x:Name="DestinationName" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock x:Name="DestinationAccount" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="WarningText" Text="Progresso não salvo pode ser perdido. O jogo atual será encerrado antes de continuar."
                            TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}" Margin="0,0,0,14" />
                        <DockPanel Margin="0,0,0,16">
                            <local:BusyRing x:Name="ProgressRing" Width="20" Height="20" Margin="0,0,10,0" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Center">
                    <ui:Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" IsDefault="True" Margin="0,4,8,0" Click="Cancel_Click" />
                    <ui:Button x:Name="ContinueButton" Content="Aguarde 5s" IsEnabled="False" Appearance="Primary" Margin="0,4,0,0" Click="Continue_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
</Window>
