<Window
    x:Class="SteamSwitcher.Views.Dialogs.EditAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    
    <Window.Effect>
        <DropShadowEffect
        Color="Transparent"
        BlurRadius="0"
        ShadowDepth="0" />
    </Window.Effect>

    <Window.Resources>
        <converters:PathToImageSourceConverter x:Key="PathToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:EmptyStringToBoolConverter x:Key="EmptyStringToBool" />

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>

        <Style x:Key="DialogComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Overlay escurecido cobrindo tudo -->
    <Border Background="{DynamicResource AppDialogBackdropBrush}">
        <Border
            x:Name="DialogCard"
            Opacity="0"
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0"
            Width="520">
            
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            
            <StackPanel>

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <ic:SymbolIcon
                        Symbol="Edit"
                        FontSize="18"
                        Foreground="{DynamicResource AppAccentAltBrush}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Editar conta"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- 2 colunas -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Coluna esquerda: Avatar + Nome -->
                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="AVATAR"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AppTextMutedBrush}"
                            Margin="0,0,0,10" />

                        <!-- Preview + botões -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="60" Height="60"
                                CornerRadius="30"
                                BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                BorderThickness="2">
                                <Border.Background>
                                    <ImageBrush
                                        ImageSource="{Binding AvatarPreviewPath,
                                            Converter={StaticResource PathToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Padding="8,6"
                                    Margin="0,0,0,6"
                                    Command="{Binding BrowseAvatarCommand}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Image" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Escolher" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Padding="8,6"
                                    Appearance="Secondary"
                                    Command="{Binding RemoveAvatarCommand}"
                                    IsEnabled="{Binding CustomAvatarPath, Converter={StaticResource EmptyStringToBool}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Delete" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Remover" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="⚠ Apenas neste app."
                            FontSize="10"
                            Foreground="{DynamicResource AppTextMutedBrush}"
                            Margin="0,0,0,20" />

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,16" />

                        <TextBlock
                            Text="NOME DE EXIBIÇÃO"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AppTextMutedBrush}"
                            Margin="0,0,0,8" />

                        <ui:TextBox
                            PlaceholderText="Nome da Steam (padrão)"
                            Text="{Binding CustomDisplayName, UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="64"
                            Margin="0,0,0,6" />

                        <TextBlock
                            Text="⚠ Apenas neste app."
                            FontSize="10"
                            Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>

                    <!-- Coluna direita: Status -->
                    <StackPanel Grid.Column="2">

                        <TextBlock
        Text="STATUS AO ENTRAR"
        FontSize="10"
        FontWeight="Bold"
        Foreground="{DynamicResource AppTextMutedBrush}"
        Margin="0,0,0,10" />

                        <TextBlock
        Text="Status do Steam ao trocar para esta conta."
        FontSize="11"
        Foreground="{DynamicResource AppTextMutedBrush}"
        TextWrapping="Wrap"
        Margin="0,0,0,12" />

                        <ComboBox
                            ItemsSource="{Binding LoginStateOptions}"
                            SelectedItem="{Binding SelectedLoginStateItem}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource DialogComboBoxStyle}"
                            ItemContainerStyle="{StaticResource DialogComboBoxItemStyle}"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <ic:SymbolIcon
                        Symbol="{Binding Icon}"
                        FontSize="14"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                                            <ic:SymbolIcon.Style>
                                                <Style TargetType="ic:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="3">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="7">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ic:SymbolIcon.Style>
                                        </ic:SymbolIcon>
                                        <TextBlock
                        Text="{Binding Label}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock
        Text="⚠ Apenas neste app."
        FontSize="10"
        Foreground="{DynamicResource AppTextMutedBrush}"
        Margin="0,8,0,0" />

                    </StackPanel>
                </Grid>

                <!-- Separador -->
                <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,20,0,16" />

                <!-- Botões -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        Grid.Column="0"
                        Content="Cancelar"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="CancelButton_Click" />
                    <ui:Button
                        Grid.Column="2"
                        Content="Salvar"
                        Style="{StaticResource SteamSwitcherPrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="SaveButton_Click" />
                </Grid>

            </StackPanel>
        </Border>
    </Border>
</Window>
