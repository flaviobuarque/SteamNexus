<Window x:Class="SteamSwitcher.Views.Dialogs.RepairRememberPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ResizeMode="NoResize" ShowInTaskbar="False" Width="760" Height="620"
    WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Background="{DynamicResource AppDialogBackdropBrush}">
        <Border Width="560" MaxHeight="540" Margin="20" Padding="24" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Corrigir lembrar senha" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock Grid.Row="1" x:Name="Summary" Margin="0,10,0,16" TextWrapping="Wrap"
                    Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <ScrollViewer Grid.Row="2" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" Margin="0,0,8,6" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}">
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalContentAlignment="Stretch"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Account.AccountName, StringFormat=@{0}}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Account.SteamId64}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="3" x:Name="Feedback" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}" />
                <WrapPanel Grid.Row="4" HorizontalAlignment="Center">
                    <ui:Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0,4,8,0" />
                    <ui:Button x:Name="SelectedButton" Content="Corrigir selecionados" Appearance="Primary" Click="Selected_Click" Margin="0,4,8,0" />
                    <ui:Button x:Name="AllButton" Content="Corrigir todos" Click="All_Click" Margin="0,4,0,0" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
</Window>
