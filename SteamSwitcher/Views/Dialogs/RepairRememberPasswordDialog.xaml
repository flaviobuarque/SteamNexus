<Window x:Class="SteamSwitcher.Views.Dialogs.RepairRememberPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ResizeMode="NoResize" ShowInTaskbar="False" Width="760" Height="620"
    WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Background="{DynamicResource AppDialogBackdropBrush}">
        <Border x:Name="DialogCard" Width="580" MaxHeight="570" Margin="20" Padding="24" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Lembrar contas na Steam" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <StackPanel Grid.Row="1" Margin="0,10,0,12">
                <TextBlock x:Name="Summary" TextWrapping="Wrap"
                    Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="SelectionSummary" Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,8,6" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" /></Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Stretch"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Account.AccountName, StringFormat=@{0}}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Account.SteamId64, StringFormat=SteamID: {0}}" FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource AppTextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0,12,0,16">
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <ProgressBar x:Name="RepairProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="5"
                                Foreground="{DynamicResource AppAccentBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Backup automático · A Steam pode solicitar login novamente."
                        Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" />
                </StackPanel>
                <WrapPanel Grid.Row="4" HorizontalAlignment="Center">
                    <ui:Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0,4,8,0" />
                    <ui:Button x:Name="SelectedButton" Content="Corrigir selecionados" IsEnabled="False" Appearance="Primary" Click="Selected_Click" Margin="0,4,8,0" />
                    <ui:Button x:Name="AllButton" Content="Corrigir todos" Click="All_Click" Margin="0,4,0,0" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
</Window>
