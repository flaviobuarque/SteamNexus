<Window
    x:Class="SteamSwitcher.Views.Dialogs.AddGameCoverDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Window.Effect>
        <DropShadowEffect
            Color="Transparent"
            BlurRadius="0"
            ShadowDepth="0" />
    </Window.Effect>

    <Border Background="{DynamicResource AppDialogBackdropBrush}">
        <Border
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="440"
            x:Name="DialogCard"
            Opacity="0">

            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <StackPanel>

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ic:SymbolIcon
                        Symbol="Image"
                        FontSize="18"
                        Foreground="{DynamicResource AppAccentAltBrush}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Adicionar capa"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource AppTextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,16">
                    <Run Text="Capa para" />
                    <Run Text="{Binding GameName, Mode=OneWay}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </TextBlock>

                <!-- Preview -->
                <Border
                    Width="160" Height="240"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                    <Grid>
                        <Image
                            Source="{Binding PreviewImage}"
                            Stretch="UniformToFill" />
                        <ic:SymbolIcon
                            Symbol="Image"
                            FontSize="40"
                            Foreground="{DynamicResource AppTextMutedBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PreviewImage,
                                Converter={x:Static converters:NullToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>

                <!-- Info -->
                <TextBlock
                    Text="ℹ A imagem deve ter proporção 2:3 (ex.: 600×900 ou 342×482)."
                    FontSize="11"
                    Foreground="{DynamicResource AppTextMutedBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8" />

                <!-- Dimensões + proporção + status -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Dimensões: " FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                    <TextBlock Text="{Binding DimensionsText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Proporção: " FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                    <TextBlock Text="{Binding RatioText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding ValidationText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,12" />

                <!-- Botoes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ui:Button
                        Content="Escolher imagem"
                        Padding="12,8"
                        Margin="0,0,10,0"
                        Command="{Binding BrowseCoverCommand}" />
                    <ui:Button
                        Content="Remover"
                        Padding="12,8"
                        Appearance="Secondary"
                        Command="{Binding RemoveCoverCommand}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,16,0,16" />

                <!-- Footer -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        Grid.Column="0"
                        Content="Cancelar"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="CancelButton_Click" />
                    <ui:Button
                        Grid.Column="2"
                        Content="Salvar"
                        Appearance="Primary"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        IsEnabled="{Binding IsValid}"
                        Click="ConfirmButton_Click" />
                </Grid>

            </StackPanel>
        </Border>
    </Border>
</Window>
