<Window x:Class="SteamSwitcher.Views.Dialogs.ThemeColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Escolher cor" Width="760" Height="610" MinWidth="700" MinHeight="560"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Escolher cor" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
            <TextBlock Text="Arraste pela área de cor ou escolha uma opção da paleta." Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
            <Border Padding="16" CornerRadius="12" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid x:Name="ColorArea" Height="258" Cursor="Cross" ClipToBounds="True" MouseLeftButtonDown="ColorArea_MouseLeftButtonDown" MouseMove="ColorArea_MouseMove">
                        <Rectangle RadiusX="7" RadiusY="7">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="White" Offset="0"/><GradientStop x:Name="HueGradientStop" Color="Red" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="7" RadiusY="7">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False"><Ellipse x:Name="ColorSelector" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent"><Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.9"/></Ellipse.Effect></Ellipse></Canvas>
                    </Grid>

                    <TextBlock Text="Matiz" Margin="0,14,0,5" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                    <Grid x:Name="HueBar" Height="16" Cursor="Hand" MouseLeftButtonDown="HueBar_MouseLeftButtonDown" MouseMove="HueBar_MouseMove">
                        <Border CornerRadius="8"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FFFF0000" Offset="0"/><GradientStop Color="#FFFFFF00" Offset="0.167"/><GradientStop Color="#FF00FF00" Offset="0.333"/><GradientStop Color="#FF00FFFF" Offset="0.5"/><GradientStop Color="#FF0000FF" Offset="0.667"/><GradientStop Color="#FFFF00FF" Offset="0.833"/><GradientStop Color="#FFFF0000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Canvas IsHitTestVisible="False"><Border x:Name="HueSelector" Width="8" Height="22" Margin="0,-3,0,0" Background="White" BorderBrush="#99000000" BorderThickness="1" CornerRadius="4"/></Canvas>
                    </Grid>

                    <TextBlock Text="Transparência" Margin="0,13,0,5" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                    <Grid x:Name="AlphaBar" Height="14" Cursor="Hand" MouseLeftButtonDown="AlphaBar_MouseLeftButtonDown" MouseMove="AlphaBar_MouseMove">
                        <Border CornerRadius="7" Background="{DynamicResource AppSurfaceAltBrush}"/>
                        <Border CornerRadius="7"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop x:Name="AlphaTransparentStop" Color="#00FFFFFF" Offset="0"/><GradientStop x:Name="AlphaOpaqueStop" Color="#FFFFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Canvas IsHitTestVisible="False"><Border x:Name="AlphaSelector" Width="8" Height="20" Margin="0,-3,0,0" Background="White" BorderBrush="#99000000" BorderThickness="1" CornerRadius="4"/></Canvas>
                    </Grid>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="HexTextBox" TextChanged="HexTextBox_TextChanged" MaxLength="9" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="AlphaText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <Border x:Name="PreviewBorder" Grid.Column="2" Margin="8,0,0,0" CornerRadius="7" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"/>
                    </Grid>
                    <TextBlock x:Name="ValidationText" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource AppDangerBrush}"/>
                    <Grid Margin="0,14,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cores salvas" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/><Button Grid.Column="1" Content="+ Adicionar" Click="AddSavedColor_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource AppAccentBrush}"/></Grid>
                    <WrapPanel x:Name="SavedColorsPanel"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" CornerRadius="12" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Paleta rápida" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="Tons organizados por família" Margin="0,3,0,16" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    <WrapPanel x:Name="PalettePanel" HorizontalAlignment="Center"/>
                    <Separator Margin="0,18,0,14" Background="{DynamicResource AppBorderBrush}"/>
                    <TextBlock Text="Dica" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="Use transparência para superfícies e sobreposições. Para textos, prefira 100%." Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Formato: #RRGGBB ou #AARRGGBB" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
            <ui:Button Grid.Column="1" Content="Cancelar" Appearance="Secondary" Width="110" Margin="0,0,10,0" Click="Cancel_Click"/>
            <ui:Button Grid.Column="2" Content="Usar esta cor" Style="{StaticResource SteamSwitcherPrimaryButtonStyle}" Width="140" Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>
