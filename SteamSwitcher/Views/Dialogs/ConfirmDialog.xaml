<Window
    x:Class="SteamSwitcher.Views.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

	<Window.Resources>
		<Style x:Key="DangerButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#C0392B" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#A93226" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

    <Border Background="#AA000000">
        <Border
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="28,24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MinWidth="360"
            MaxWidth="420">
            <StackPanel>

                <!-- Ícone + título -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ic:SymbolIcon
                        x:Name="DialogIcon"
                        FontSize="22"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Mensagem -->
                <TextBlock
                    x:Name="MessageText"
                    FontSize="13"
                    Foreground="{DynamicResource AppTextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,24"
                    LineHeight="20" />

                <!-- Botões -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="CancelButton"
                        Content="Cancelar"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Name="ConfirmButton"
                        Padding="18,8"
                        Cursor="Hand"
                        Click="ConfirmButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1F6FEB" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1a5fd4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>