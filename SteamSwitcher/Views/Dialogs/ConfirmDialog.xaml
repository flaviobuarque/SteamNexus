<Window x:Class="SteamSwitcher.Views.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
    Width="800" Height="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border Background="#AA000000">
        <Border x:Name="DialogCard" Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14"
                Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ic:SymbolIcon x:Name="DialogIcon" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="20" />
                </ScrollViewer>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Cancelar" Margin="0,4,8,0"
                            Style="{StaticResource NexusActionButton}" Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton" Margin="0,4,0,0"
                            Style="{StaticResource NexusPrimaryButton}" Click="ConfirmButton_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
</Window>
