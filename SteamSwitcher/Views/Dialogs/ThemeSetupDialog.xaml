<Window x:Class="SteamSwitcher.Views.Dialogs.ThemeSetupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Width="510" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Border Padding="24" CornerRadius="14" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
  <StackPanel>
   <TextBlock x:Name="Heading" Text="Criar tema" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
   <StackPanel x:Name="BasePanel" Margin="0,18,0,0">
    <TextBlock Text="1. Escolha o ponto de partida" Margin="0,0,0,8" Foreground="{DynamicResource AppTextSecondaryBrush}" />
    <ComboBox x:Name="BaseChoice" DisplayMemberPath="Name" SelectionChanged="Base_Changed" />
    <Border x:Name="Sample" Margin="0,10,0,0" Padding="14" CornerRadius="8">
     <StackPanel Orientation="Horizontal"><Border x:Name="AccentSample" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0"/><TextBlock x:Name="SampleText" Text="Prévia da base" VerticalAlignment="Center"/></StackPanel>
    </Border>
   </StackPanel>
   <TextBlock Text="Nome do tema" Margin="0,18,0,8" Foreground="{DynamicResource AppTextSecondaryBrush}" />
   <TextBox x:Name="NameBox" MaxLength="60" />
   <TextBlock x:Name="Hint" Text="Uma nova cópia será criada. O tema original será preservado." TextWrapping="Wrap" Margin="0,12,0,16" Foreground="{DynamicResource AppTextMutedBrush}" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button Content="Cancelar" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
    <ui:Button x:Name="ContinueButton" Content="Personalizar" Appearance="Primary" Click="Continue_Click" />
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
