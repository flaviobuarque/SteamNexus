<Window
    x:Class="SteamSwitcher.Views.Dialogs.ThemeEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    Title="Editor de tema — SteamNexus" Width="1050" Height="720" MinWidth="920" MinHeight="620"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ThemeSliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                    Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderRoot" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource ThemeSliderTrackButton}"
                                                  Background="{DynamicResource AppAccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Handle" Margin="3"
                                                             Fill="{DynamicResource AppAccentBrush}"
                                                             Stroke="{DynamicResource AppSurfaceBrush}" StrokeThickness="2"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Fill" Value="{DynamicResource AppAccentAltBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Handle" Property="Fill" Value="{DynamicResource AppAccentAltBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                        <Setter TargetName="Handle" Property="Stroke" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource ThemeSliderTrackButton}"
                                                  Background="{DynamicResource AppBorderBrush}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SliderRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="TabBackground" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AppTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeEditorAccentButtonStyle" TargetType="ui:Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AppButtonCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppAccentAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Width="4"
                                                    Background="{DynamicResource AppAccentBrush}" CornerRadius="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="6" />
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AppAccentAltBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Editor de tema" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock Text="Personalize a aparência com prévia antes de salvar."
                           Margin="0,5,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,5" CornerRadius="7" VerticalAlignment="Top"
                    Background="{DynamicResource AppAccentSurfaceBrush}">
                <TextBlock Text="{Binding ContrastStatus}" Foreground="{DynamicResource AppAccentBrush}"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nome do tema" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0"
                                 IsEnabled="{Binding IsCustomTheme}" AutomationProperties.Name="Nome do tema" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,5" CornerRadius="6" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            Background="{DynamicResource AppAccentSurfaceBrush}">
                        <TextBlock Text="{Binding BaseThemeLabel}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </Border>
                </Grid>
            <TabControl x:Name="EditorTabs" Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}">
                <TabItem x:Name="AppearanceTab" Style="{StaticResource EditorTabStyle}">
                    <TabItem.Header><StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="Color" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Aparência"/>
                    </StackPanel></TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <ItemsControl ItemsSource="{Binding Colors}" IsEnabled="{Binding IsCustomTheme}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <Button Grid.Column="1" Width="26" Height="26" Padding="0"
                                                    ToolTip="Escolher cor" Click="ColorSwatch_Click"
                                                    Background="Transparent" BorderThickness="0">
                                                <Border Width="24" Height="24" CornerRadius="5"
                                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                        Background="{Binding PreviewBrush}" />
                                            </Button>
                                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="EditorValue_Changed" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="BackgroundTab" Style="{StaticResource EditorTabStyle}" IsEnabled="{Binding IsCustomTheme}">
                    <TabItem.Header><StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="Image" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Fundo"/>
                    </StackPanel></TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18">
                        <TextBlock Text="Imagem de fundo" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="A imagem será copiada para a biblioteca local de temas."
                                   Margin="0,4,0,10" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}">
                            <TextBlock Text="{Binding BackgroundImageDisplay}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                            <ui:Button Content="Escolher imagem" Click="ChooseBackground_Click" Margin="0,0,8,0" />
                            <ui:Button Content="Remover imagem" Appearance="Secondary" Click="RemoveBackground_Click" />
                        </StackPanel>

                        <TextBlock Text="Opacidade da imagem" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Grid Margin="0,7,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding BackgroundOpacity}"
                                    ValueChanged="EditorValue_Changed" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="Desfoque da imagem" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Grid Margin="0,7,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="24" SmallChange="1" Value="{Binding BackgroundBlurRadius}"
                                    ValueChanged="EditorValue_Changed" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundBlurRadius, StringFormat={}{0:F0} px}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="Filtro para legibilidade" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Aplica uma cor transparente sobre a imagem para facilitar a leitura dos textos."
                                   Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <ui:Button Content="{Binding BackgroundOverlay}" Click="BackgroundOverlay_Click"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Background="{DynamicResource AppSurfaceBrush}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   BorderBrush="{DynamicResource AppBorderBrush}"
                                   ToolTip="Escolher cor e transparência do filtro"
                                   AutomationProperties.Name="Escolher cor e transparência do filtro"
                                   Margin="0,7,0,18" />

                        <TextBlock Text="Ajuste da imagem" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding StretchOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding BackgroundStretch}"
                                  Margin="0,7,0,0" SelectionChanged="EditorValue_Changed" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>


            </TabControl>
            </Grid>

            <Border Grid.Column="2" Padding="20" CornerRadius="14"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Width="340" Margin="0,0,0,8">
                    <TextBlock Text="Prévia" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Componentes reais do tema" Margin="0,4,0,10"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <Border Padding="12" CornerRadius="{DynamicResource AppCardCornerRadius}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Left"
                                    Background="{DynamicResource AppAccentSurfaceBrush}">
                                <ic:SymbolIcon Symbol="Person" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Conta de exemplo" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text="@steamnexus" Margin="0,2,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            </StackPanel>
                            </Grid>
                            <TextBox Text="Campo de busca" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Ação principal" Style="{StaticResource ThemeEditorAccentButtonStyle}" Margin="0,0,8,0" />
                                <ui:Button Content="Secundário" Appearance="Secondary" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Padding="8,3" CornerRadius="6" Background="{DynamicResource AppSuccessSurfaceBrush}">
                                    <TextBlock Text="Sucesso" Foreground="{DynamicResource AppSuccessBrush}" />
                                </Border>
                                <Border Padding="8,3" CornerRadius="6" Margin="7,0,0,0" Background="{DynamicResource AppWarningSurfaceBrush}">
                                    <TextBlock Text="Aviso" Foreground="{DynamicResource AppWarningBrush}" />
                                </Border>
                                <Border Padding="8,3" CornerRadius="6" Margin="7,0,0,0" Background="{DynamicResource AppDangerSurfaceBrush}">
                                    <TextBlock Text="Erro" Foreground="{DynamicResource AppDangerBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Viewbox>
                    <StackPanel Grid.Row="1">
                    <Border Margin="0,18,0,0" Padding="12" CornerRadius="8"
                            Background="{DynamicResource AppSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding ContrastStatus}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text="{Binding ContrastDetail}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="Verificação dos textos sobre cartões. A imagem de fundo não é avaliada."
                                       Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                            <ui:Button Content="Corrigir contraste dos textos" Click="FixContrast_Click"
                                       Margin="0,10,0,0" HorizontalAlignment="Left"
                                       IsEnabled="{Binding IsCustomTheme}"
                                       Visibility="{Binding HasContrastIssues, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ValidationMessage}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppWarningBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Restaurar aparência" Appearance="Secondary" Click="Reset_Click"
                           Visibility="{Binding IsSelected, ElementName=AppearanceTab, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancelar" Appearance="Secondary" Width="110" Click="Cancel_Click" Margin="0,0,10,0" />
                <ui:Button Content="Salvar e aplicar" Style="{StaticResource ThemeEditorAccentButtonStyle}" Width="150" Click="Apply_Click"
                           Visibility="{Binding IsPresetReadOnly, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
