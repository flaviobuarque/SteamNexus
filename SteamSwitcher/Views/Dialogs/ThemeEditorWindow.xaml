<Window
    x:Class="SteamSwitcher.Views.Dialogs.ThemeEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    Title="Editor de tema — SteamNexus" Width="1050" Height="720" MinWidth="920" MinHeight="620"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Editor de tema" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock Text="Personalize a aparência com prévia antes de salvar."
                           Margin="0,5,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,5" CornerRadius="7"
                    Background="{DynamicResource AppAccentSurfaceBrush}">
                <TextBlock Text="{Binding ContrastStatus}" Foreground="{DynamicResource AppAccentBrush}"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <TabControl Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}">
                <TabItem Header="Cores">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Nome do tema" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,12,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tema-base" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <ComboBox ItemsSource="{Binding BaseThemes}" SelectedItem="{Binding BaseTheme}"
                                              Margin="0,6,0,0" SelectionChanged="BaseTheme_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1" Content="Aplicar preset" Appearance="Secondary" Click="ApplyPreset_Click" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Colors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="5"
                                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                    Background="{Binding PreviewBrush}" />
                                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="EditorValue_Changed" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Fundo">
                    <StackPanel Margin="18">
                        <TextBlock Text="Imagem de fundo" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="A imagem será copiada para a biblioteca local de temas."
                                   Margin="0,4,0,10" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}">
                            <TextBlock Text="{Binding BackgroundImageDisplay}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                            <ui:Button Content="Escolher imagem" Click="ChooseBackground_Click" Margin="0,0,8,0" />
                            <ui:Button Content="Remover" Appearance="Secondary" Click="RemoveBackground_Click" />
                        </StackPanel>

                        <TextBlock Text="Opacidade da imagem" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Grid Margin="0,7,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding BackgroundOpacity}"
                                    ValueChanged="EditorValue_Changed" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="Desfoque da imagem" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Grid Margin="0,7,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="24" SmallChange="1" Value="{Binding BackgroundBlurRadius}"
                                    ValueChanged="EditorValue_Changed" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundBlurRadius, StringFormat={}{0:F0} px}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="Camada de contraste" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBox Text="{Binding BackgroundOverlay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,18" TextChanged="EditorValue_Changed" />

                        <TextBlock Text="Ajuste da imagem" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding StretchOptions}" SelectedItem="{Binding BackgroundStretch}"
                                  Margin="0,7,0,0" SelectionChanged="EditorValue_Changed" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Componentes">
                    <StackPanel Margin="18">
                        <TextBlock Text="Arredondamento dos cartões" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Slider Minimum="0" Maximum="28" Value="{Binding CardCornerRadius}"
                                Margin="0,8,0,4" ValueChanged="EditorValue_Changed" />
                        <TextBlock Text="{Binding CardCornerRadius, StringFormat={}{0:F0} px}"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />

                        <TextBlock Text="Arredondamento dos botões" FontWeight="SemiBold" Margin="0,22,0,0"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Slider Minimum="0" Maximum="20" Value="{Binding ButtonCornerRadius}"
                                Margin="0,8,0,4" ValueChanged="EditorValue_Changed" />
                        <TextBlock Text="{Binding ButtonCornerRadius, StringFormat={}{0:F0} px}"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />

                        <TextBlock Text="Intensidade das bordas" FontWeight="SemiBold" Margin="0,22,0,0"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Slider Minimum="0.2" Maximum="1" Value="{Binding BorderOpacity}"
                                Margin="0,8,0,4" ValueChanged="EditorValue_Changed" />
                        <TextBlock Text="{Binding BorderOpacity, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />

                        <CheckBox Content="Ativar sombras" IsChecked="{Binding ShadowsEnabled}"
                                  Margin="0,22,0,0" Click="EditorValue_Changed" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Compartilhar">
                    <StackPanel Margin="18">
                        <TextBlock Text="Importar e exportar" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Compartilhe as configurações visuais em um arquivo .steamnexus-theme."
                                   Margin="0,5,0,16" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <ui:Button Content="Importar tema" Click="ImportTheme_Click" Margin="0,0,0,8" />
                        <ui:Button Content="Exportar tema" Appearance="Secondary" Click="ExportTheme_Click" />
                        <Border Margin="0,22,0,0" Padding="13" CornerRadius="9"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <TextBlock Text="{Binding ContrastDetail}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Border>
                        <ui:Button Content="Corrigir contraste automaticamente" Appearance="Secondary"
                                   Margin="0,10,0,0" Click="FixContrast_Click" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Column="2" Padding="20" CornerRadius="14"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Prévia" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Componentes reais do tema" Margin="0,4,0,18"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <Border Padding="18" CornerRadius="{DynamicResource AppCardCornerRadius}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Border Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Left"
                                    Background="{DynamicResource AppAccentSurfaceBrush}">
                                <ic:SymbolIcon Symbol="Person" FontSize="25" Foreground="{DynamicResource AppAccentBrush}" />
                            </Border>
                            <TextBlock Text="Conta de exemplo" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,0"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text="@steamnexus" Margin="0,3,0,14"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBox Text="Campo de busca" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Ação principal" Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button Content="Secundário" Appearance="Secondary" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Padding="8,3" CornerRadius="6" Background="{DynamicResource AppSuccessSurfaceBrush}">
                                    <TextBlock Text="Sucesso" Foreground="{DynamicResource AppSuccessBrush}" />
                                </Border>
                                <Border Padding="8,3" CornerRadius="6" Margin="7,0,0,0" Background="{DynamicResource AppWarningSurfaceBrush}">
                                    <TextBlock Text="Aviso" Foreground="{DynamicResource AppWarningBrush}" />
                                </Border>
                                <Border Padding="8,3" CornerRadius="6" Margin="7,0,0,0" Background="{DynamicResource AppDangerSurfaceBrush}">
                                    <TextBlock Text="Erro" Foreground="{DynamicResource AppDangerBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ValidationMessage}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppWarningBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Restaurar tema-base" Appearance="Secondary" Click="Reset_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancelar" Appearance="Secondary" Width="110" Click="Cancel_Click" Margin="0,0,10,0" />
                <ui:Button Content="Aplicar tema" Appearance="Primary" Width="130" Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
