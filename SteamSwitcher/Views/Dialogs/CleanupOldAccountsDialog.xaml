<Window
    x:Class="SteamSwitcher.Views.Dialogs.CleanupOldAccountsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Width="800" Height="600"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Border Background="#88000000">
        <Border
            Width="470"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            CornerRadius="14"
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ic:SymbolIcon Symbol="Delete" FontSize="22"
                        Foreground="{DynamicResource AppDangerBrush}"
                        Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Limpar contas antigas" FontSize="18" FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    Text="Escolha há quanto tempo uma conta precisa estar sem acesso para ser removida deste computador."
                    TextWrapping="Wrap" FontSize="13" LineHeight="19"
                    Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,18" />

                <TextBlock Text="Sem acesso há mais de" FontSize="12" FontWeight="SemiBold"
                    Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,6" />
                <ComboBox
                    x:Name="PeriodComboBox"
                    ItemsSource="{Binding Periods}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Months"
                    SelectedValue="{Binding SelectedMonths, Mode=TwoWay}"
                    SelectionChanged="PeriodComboBox_SelectionChanged"
                    MinHeight="36" Margin="0,0,0,16" />

                <Border
                    Padding="14,12" CornerRadius="9"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="CandidateCountText" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="CandidateNamesText" FontSize="11"
                            TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource AppDangerSurfaceBrush}"
                    BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                    Margin="0,0,0,20">
                    <TextBlock
                        Text="A conta ativa e contas sem data confiável nunca serão removidas. A Steam será fechada e um backup loginusers.vdf.cleanup.bak será criado."
                        FontSize="11" TextWrapping="Wrap" LineHeight="17"
                        Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Appearance="Secondary"
                        MinHeight="42" Padding="14,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="ConfirmButton" Grid.Column="2"
                        Appearance="Danger" MinHeight="42" Padding="14,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="ConfirmButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ic:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock x:Name="ConfirmButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>
