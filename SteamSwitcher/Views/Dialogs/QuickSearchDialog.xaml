<Window x:Class="SteamSwitcher.Views.Dialogs.QuickSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SteamSwitcher.Converters"
        Title="Busca rápida" Width="640" Height="560" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource AppTextPrimaryBrush}">
    <Window.Resources>
        <local:SearchThumbnailConverter x:Key="SearchThumbnail" />
        <Style x:Key="SearchResultCard" TargetType="ListBoxItem" BasedOn="{StaticResource NexusResultItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Margin="0,3,4,3" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource AppSurfaceBrush}">
                            <Grid>
                                <Border x:Name="SelectedStripe" Width="3" Margin="0,10,0,10" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="{DynamicResource AppAccentBrush}" Visibility="Collapsed" />
                                <ContentPresenter Margin="12,10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                <Setter TargetName="SelectedStripe" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="BackdropGrid" Background="{DynamicResource AppDialogBackdropBrush}" MouseDown="Backdrop_MouseDown">
        <Grid x:Name="DialogCard" MaxWidth="640" MaxHeight="560" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Sombra desacoplada para evitar desfoque e manter texto nítido com ClearType -->
            <Border CornerRadius="16" Background="{DynamicResource AppChromeBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000" />
                </Border.Effect>
            </Border>

            <!-- Card de conteúdo sem Effect -->
            <Border Background="{DynamicResource AppChromeBrush}"
                    BorderBrush="{DynamicResource AppBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="16">
                <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="O que você quer abrir?" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="CloseButton_Click" ToolTip="Fechar (Esc)"
                            Style="{StaticResource NexusActionButton}" Width="32" Height="32" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Button>
                </Grid>
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Background="{DynamicResource AppSurfaceBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid MinHeight="44">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" FontSize="18" Foreground="{DynamicResource AppTextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="SearchBox" FontSize="14" Padding="0,11,12,11"
                                 Style="{x:Null}" FocusVisualStyle="{x:Null}" BorderBrush="Transparent"
                                 TextChanged="SearchChanged" Background="Transparent" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 BorderThickness="0" AutomationProperties.Name="Buscar jogos, contas ou páginas">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ScrollViewer x:Name="PART_ContentHost" />
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock Grid.Column="1" Text="Buscar jogos, contas ou páginas…" Margin="0,0,12,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" x:Name="Hint" Margin="0,14,0,6" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" Text="Acesso rápido" />
                <Grid Grid.Row="3" Margin="0,0,-14,0">
                    <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource SearchResultCard}" SelectionChanged="SelectionChanged" MouseDoubleClick="OpenSelected">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="False"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter Margin="0,0,14,0" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <!-- Search is capped at 40 results: use exact pixel extents rather than
                             rounding the viewport to whole items and leaving a trailing gap. -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextMutedBrush}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Symbol" Value="Info24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=ResultThumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Jogo"><Setter Property="Symbol" Value="XboxController24" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Conta"><Setter Property="Symbol" Value="People24" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="page:Accounts"><Setter Property="Symbol" Value="People24" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="page:Games"><Setter Property="Symbol" Value="XboxController24" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="page:Settings"><Setter Property="Symbol" Value="Settings24" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="page:Diagnostics"><Setter Property="Symbol" Value="Wrench24" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="page:Activity"><Setter Property="Symbol" Value="History24" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <Border Width="36" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image x:Name="ResultThumbnail" Source="{Binding ImagePath, Converter={StaticResource SearchThumbnail}}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Stretch" Value="Uniform" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Conta">
                                                        <Setter Property="Height" Value="36" />
                                                        <Setter Property="Stretch" Value="UniformToFill" />
                                                        <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" /></Setter.Value></Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,8,0"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Margin="8,0,0,0" Padding="7,3" CornerRadius="5"
                                        VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                                        Background="{DynamicResource AppChromeBrush}">
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <ui:SymbolIcon Symbol="Search24" FontSize="26" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhum resultado encontrado" FontWeight="SemiBold" Margin="0,12,0,4" TextAlignment="Center" />
                        <TextBlock Text="Tente outro nome de jogo, conta ou página." TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="4" Margin="0,12" FontSize="12" Text="Você escolhe quando jogar ou trocar de conta."
                           TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" />
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="↑ ↓ Navegar · Enter Abrir · Esc Fechar" FontSize="11" Margin="0,0,12,0" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Fechar" IsCancel="True" Style="{StaticResource NexusActionButton}" Margin="0,0,8,0" />
                        <Button x:Name="OpenButton" Content="Selecione uma opção" IsEnabled="False" Click="OpenSelected" Style="{StaticResource NexusPrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
