<Window
    x:Class="SteamSwitcher.Views.Dialogs.PickAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

	<Window.Effect>
		<DropShadowEffect
            Color="Transparent"
            BlurRadius="0"
            ShadowDepth="0" />
	</Window.Effect>

	<Border Background="#66000000">
		<Border
            Background="#0D2135"
            BorderBrush="#1F456A"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0"
            MinWidth="360"
			x:Name="DialogCard"
            Opacity="0">

			<Border.RenderTransform>
				<ScaleTransform ScaleX="1" ScaleY="1" />
			</Border.RenderTransform>

			<StackPanel>

				<!-- Header -->
				<StackPanel Orientation="Horizontal" Margin="0,0,0,6">
					<ui:SymbolIcon
                        Symbol="PersonQuestionMark24"
                        Foreground="#38D6C6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />
					<TextBlock
                        Text="Associar conta"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#EAF7FF"
                        VerticalAlignment="Center" />
				</StackPanel>

				<TextBlock
                    FontSize="13"
                    Foreground="#A9C8DE"
                    TextWrapping="Wrap"
                    Margin="0,0,0,4">
					<Run Text="Qual conta deve jogar" />
					<Run Text="{Binding GameName, Mode=OneWay}"
                        FontWeight="SemiBold"
                        Foreground="#EAF7FF" />
					<Run Text="?" />
				</TextBlock>

				<TextBlock
                    Text="Este jogo não possui conta associada no appmanifest."
                    FontSize="11"
                    Foreground="#6593B0"
                    Margin="0,2,0,16"
                    TextWrapping="Wrap" />

                <ui:TextBox
                    Margin="0,0,0,12"
                    PlaceholderText="Buscar conta..."
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <ScrollViewer
                    MaxHeight="280"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="0,0,0,8">
                    <!-- Lista de contas -->
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14,11"
                                    CornerRadius="10"
                                    BorderThickness="2"
                                    Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#102B45" />
                                            <Setter Property="BorderBrush" Value="#1F456A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38D6C6" />
                                                    <Setter Property="Background" Value="#143A5C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding
                                            MouseAction="LeftClick"
                                            Command="{Binding DataContext.SelectAccountCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Symbol="Person24"
                                            Foreground="#A9C8DE"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Foreground="#EAF7FF" />
                                            <TextBlock
                                                Text="{Binding AccountName, StringFormat=@{0}}"
                                                FontSize="11"
                                                Foreground="#6593B0"
                                                Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl> 
                </ScrollViewer>

                    <!-- Botões -->
				<Grid Margin="0,8,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ui:Button
                        Grid.Column="0"
                        Content="Cancelar"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="CancelButton_Click" />
					<ui:Button
                        Grid.Column="2"
                        Content="Salvar"
                        Appearance="Primary"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        IsEnabled="{Binding HasSelection}"
                        Click="ConfirmButton_Click" />
				</Grid>

			</StackPanel>
		</Border>
	</Border>
</Window>