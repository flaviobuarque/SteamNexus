<Window
    x:Class="SteamSwitcher.Views.Dialogs.HotkeyCaptureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Definir atalho global"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    PreviewKeyDown="Dialog_PreviewKeyDown"
    PreviewKeyUp="Dialog_PreviewKeyUp">

    <Border Padding="28" Background="{DynamicResource AppSurfaceBrush}">
        <StackPanel>
            <TextBlock Text="Definir atalho global"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

            <TextBlock
                Margin="0,8,0,20"
                Text="Pressione Ctrl, Shift, Alt ou Win junto com uma tecla."
                TextWrapping="Wrap"
                Foreground="{DynamicResource AppTextMutedBrush}" />

            <Border
                Padding="18"
                CornerRadius="8"
                Background="{DynamicResource AppSurfaceHoverBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        x:Name="HotkeyText"
                        Text="Aguardando atalho..."
                        FontSize="22"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource AppTextPrimaryBrush}" />

                    <TextBlock
                        x:Name="HintText"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="{DynamicResource AppTextMutedBrush}"
                        Text="Segure os modificadores e pressione a tecla principal." />
                </StackPanel>
            </Border>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,24,0,0">

                <Button
                    Content="Cancelar"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    IsCancel="True" />

                <Button
                    x:Name="ConfirmButton"
                    Content="Usar atalho"
                    MinWidth="120"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>