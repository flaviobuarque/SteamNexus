<Window x:Class="SteamSwitcher.Views.Dialogs.GameLoginStateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="800" Height="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource AppDialogBackdropBrush}">
        <Border Width="420" Padding="24" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Status ao entrar" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock x:Name="GameNameText" Margin="0,5,0,16" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <ComboBox x:Name="StateCombo" ItemsSource="{Binding}" DisplayMemberPath="Label" />
                <TextBlock Text="O status será aplicado ao iniciar este jogo." Margin="0,10,0,18" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Content="Cancelar" Appearance="Secondary" Click="Cancel_Click" />
                    <ui:Button Grid.Column="2" Content="Salvar" Style="{StaticResource SteamSwitcherPrimaryButtonStyle}" Click="Save_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>
