<UserControl
    x:Class="SteamSwitcher.Views.Controls.AccountListRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters">

    <UserControl.Resources>
        <converters:PathToImageSourceConverter x:Key="PathToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Border
        CornerRadius="12"
        Padding="14,12"
        BorderThickness="1"
        Cursor="Hand"
        Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.InputBindings>
            <MouseBinding
                MouseAction="LeftDoubleClick"
                Command="{Binding SwitchCommand,
                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}" />
        </Border.InputBindings>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Avatar -->
            <Grid Grid.Column="0" Width="44" Height="44">
                <Ellipse Width="44" Height="44">
                    <Ellipse.Fill>
                        <ImageBrush
                            ImageSource="{Binding AvatarPath,
                                Converter={StaticResource PathToImageSource}}"
                            Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Badge ativo -->
                <Ellipse
                    Width="12" Height="12"
                    Fill="{DynamicResource AppSuccessBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Nome + username -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="{Binding DisplayName}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <!-- Badge VAC -->
                    <Border
                        Background="{DynamicResource AppDangerBrush}"
                        CornerRadius="4"
                        Padding="4,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsVacBanned, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="VAC" Foreground="White" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <!-- Badge Limited -->
                    <Border
                        Background="{DynamicResource AppWarningBrush}"
                        CornerRadius="4"
                        Padding="4,1"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLimited, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LIM" Foreground="White" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <!-- Badge Ativa -->
                    <Border
    Background="{DynamicResource AppSuccessSurfaceBrush}"
    BorderBrush="{DynamicResource AppAccentBrush}"
    BorderThickness="1"
    CornerRadius="5"
    Padding="8,2"
    Margin="8,0,0,0"
    VerticalAlignment="Center"
    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="● ATIVA" Foreground="{DynamicResource AppAccentBrush}" FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="{Binding AccountName, StringFormat=@{0}}"
                    FontSize="12"
                    Foreground="{DynamicResource AppTextMutedBrush}"
                    Margin="0,3,0,0" />
            </StackPanel>

            <!-- Último login -->
            <StackPanel
    Grid.Column="5"
    Orientation="Horizontal"
    VerticalAlignment="Center"
    HorizontalAlignment="Right"
    Margin="0,0,16,0">
                <ic:SymbolIcon
        Symbol="Clock"
        FontSize="12"
        Foreground="{DynamicResource AppTextMutedBrush}"
        Margin="0,0,5,0"
        VerticalAlignment="Center" />
                <TextBlock
        Text="{Binding LastLoginFormatted}"
        FontSize="12"
        Foreground="{DynamicResource AppTextMutedBrush}"
        VerticalAlignment="Center" />
            </StackPanel>

            <!-- Botão trocar -->
            <ui:Button
                Grid.Column="6"
                Padding="12,6"
                VerticalAlignment="Center"
                Appearance="Primary"
                Visibility="Collapsed"
                Command="{Binding SwitchCommand,
                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="ArrowSwap" FontSize="13" Margin="0,0,5,0" />
                    <TextBlock Text="Trocar" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Style.Triggers>
                            <DataTrigger
                Binding="{Binding IsMouseOver,
                    RelativeSource={RelativeSource AncestorType=Border}}"
                Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </Grid>

        <Border.ContextMenu>
            <ContextMenu
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="4">
                <ContextMenu.Effect>
                    <DropShadowEffect
                        Color="#000000"
                        BlurRadius="16"
                        ShadowDepth="4"
                        Opacity="0.4" />
                        </ContextMenu.Effect>

                <MenuItem
                    Header="Trocar para esta conta"
                    Background="Transparent"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    Command="{Binding PlacementTarget.Tag.SwitchCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="ArrowSwap"
                            Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </MenuItem.Icon>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>

                <MenuItem
                    Header="Editar conta"
                    Background="Transparent"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    Command="{Binding PlacementTarget.Tag.EditCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Edit"
                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Header="Copiar SteamID64"
                    Background="Transparent"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    Command="{Binding PlacementTarget.Tag.CopySteamIdCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Copy"
                    Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator Background="{DynamicResource AppBorderBrush}"
                   Margin="6,3" />

                <MenuItem
                    Header="Esquecer conta"
                    Background="Transparent"
                    Foreground="{DynamicResource AppDangerBrush}"
                    Command="{Binding PlacementTarget.Tag.ForgetCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="{Binding}">
                            <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Delete"
                    Foreground="{DynamicResource AppDangerBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</UserControl>