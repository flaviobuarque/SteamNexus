<UserControl
    x:Class="SteamSwitcher.Views.Controls.BusyRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Ellipse
                Width="20"
                Height="20"
                Canvas.Left="2"
                Canvas.Top="2"
                Stroke="{DynamicResource AppBorderBrush}"
                StrokeThickness="2"
                Opacity="0.45" />
            <Path
                Data="M 12,2 A 10,10 0 0 1 22,12"
                Stroke="{DynamicResource AppAccentBrush}"
                StrokeThickness="2.4"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round">
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" CenterX="12" CenterY="12" />
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
