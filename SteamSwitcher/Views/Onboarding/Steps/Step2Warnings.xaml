<UserControl
    x:Class="SteamSwitcher.Views.Onboarding.Steps.Step2Warnings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:vm="clr-namespace:SteamSwitcher.ViewModels">

    <StackPanel Margin="40,0" VerticalAlignment="Center">

        <TextBlock
            Text="Antes de continuar"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,4" />
        <TextBlock
            Text="Confirme que entendeu os pontos abaixo para continuar."
            Opacity="0.5"
            Margin="0,0,0,20" />

        <!-- Aviso 1 -->
        <Border
            Margin="0,0,0,10"
            Padding="16,14"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                Value="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush"
                Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Warning1Confirmed}" Value="True">
                            <Setter Property="Background" Value="#3e8fe1" />
                            <Setter Property="BorderBrush" Value="#3e8fe1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                Text="Não use a opção Finalizar da Steam."
                FontWeight="SemiBold"
                Margin="0,0,0,4" />
                    <TextBlock
                Text="Ao usar Sair, a Steam remove os dados de login salvos da conta, impedindo que o aplicativo faça a troca automática de usuário."
                FontSize="12"
                Opacity="0.55"
                TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
            Grid.Column="1"
            IsChecked="{Binding Warning1Confirmed}"
            VerticalAlignment="Center"
            Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Aviso 2 -->
        <Border
            Margin="0,0,0,10"
            Padding="16,14"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
    Value="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush"
    Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Warning2Confirmed}" Value="True">
                            <Setter Property="Background" Value="#3e8fe1" />
                            <Setter Property="BorderBrush" Value="#3e8fe1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        Text='Marque a opção "Lembrar senha" na Steam.'
                        FontWeight="SemiBold"
                        Margin="0,0,0,4" />
                    <TextBlock
                        Text="Sempre que fizer login em uma conta, marque a opção Lembrar senha. Isso permite que o aplicativo troque de conta automaticamente e funcione corretamente."
                        FontSize="12"
                        Opacity="0.55"
                        TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    IsChecked="{Binding Warning2Confirmed}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Aviso 3 -->
        <Border
    Padding="16,14"
    CornerRadius="10"
    BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Warning3Confirmed}" Value="True">
                            <Setter Property="Background" Value="#3e8fe1" />
                            <Setter Property="BorderBrush" Value="#3e8fe1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ic:SymbolIcon
                    Symbol="ShieldKeyhole"
                    IconVariant="Filled"
                    FontSize="15"
                    Foreground="{DynamicResource AppDangerBrush}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center" />
                        <TextBlock
                    Text="Suas senhas ficam armazenadas apenas na Steam."
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                Text="Este aplicativo não salva, acessa nem envia suas senhas. A troca de contas funciona utilizando apenas as configurações locais da Steam."
                FontSize="12"
                Opacity="0.55"
                TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
            Grid.Column="1"
            IsChecked="{Binding Warning3Confirmed}"
            VerticalAlignment="Center"
            Margin="16,0,0,0" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>