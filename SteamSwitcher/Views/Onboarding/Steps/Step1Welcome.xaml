<UserControl
    x:Class="SteamSwitcher.Views.Onboarding.Steps.Step1Welcome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <StackPanel
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        MaxWidth="400">

        <Image
            Source="pack://application:,,,/Assets/logo.png"
            Height="48"
            HorizontalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            Stretch="Uniform" />

        <TextBlock
            Text="Bem-vindo ao Steam Nexus"
            FontSize="26"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            Margin="0,20,0,12" />

        <TextBlock
            TextAlignment="Center"
            FontSize="14"
            Opacity="0.6"
            TextWrapping="Wrap">
            Troque entre contas Steam com um clique, gerencie seus jogos
            e configure tudo do jeito que você quer.
        </TextBlock>

        <TextBlock
            TextAlignment="Center"
            FontSize="13"
            Opacity="0.45"
            TextWrapping="Wrap"
            Margin="0,16,0,0">
            Vamos configurar tudo rapidinho. Clique em Continuar para começar.
        </TextBlock>
    </StackPanel>
</UserControl>