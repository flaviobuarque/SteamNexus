<UserControl
    x:Class="SteamSwitcher.Views.Onboarding.Steps.Step4Import"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:converters="clr-namespace:SteamSwitcher.Converters"
    xmlns:local="clr-namespace:SteamSwitcher.Views.Controls">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Margin="40,0" VerticalAlignment="Center">

        <TextBlock
            Text="Importar contas"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,4" />
        <TextBlock
            Text="Detectamos contas existentes. Escolha como prosseguir."
            Opacity="0.5"
            Margin="0,0,0,24" />

        <!-- TcNo detectado -->
        <Border
            Padding="16,14"
            CornerRadius="10"
            BorderThickness="1"
            Margin="0,0,0,12"
            Visibility="{Binding TcNoFound, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                        Value="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush"
                        Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImportedFromTcNo}" Value="True">
                            <Setter Property="Background" Value="#1a3d2b" />
                            <Setter Property="BorderBrush" Value="#2d6a4f" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon
                            Symbol="ArrowImport"
                            FontSize="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="TcNo Account Switcher detectado"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="Importe suas contas existentes com um clique."
                        FontSize="12"
                        Opacity="0.5"
                        Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:Button
        Style="{StaticResource SteamSwitcherPrimaryButtonStyle}"
        Command="{Binding ImportFromTcNoCommand}"
        IsEnabled="{Binding ImportedFromTcNo,
            Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Spinner durante importação -->
                            <local:BusyRing
                Width="14" Height="14"
                Margin="0,0,6,0"
                Visibility="{Binding IsImporting,
                    Converter={StaticResource BoolToVisibility}}" />
                            <!-- Checkmark quando concluído -->
                            <ic:SymbolIcon
                Symbol="Checkmark"
                FontSize="13"
                Margin="0,0,6,0"
                Visibility="{Binding ImportedFromTcNo,
                    Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                Text="{Binding IsImporting,
                    Converter={StaticResource BoolToImportText}}"
                VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Mensagem de resultado -->
                    <TextBlock
        Text="{Binding ImportStatusMessage}"
        FontSize="11"
        Margin="0,6,0,0"
        TextWrapping="Wrap"
        MaxWidth="140">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#57e389" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImportStatusMessage}"
                                 Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImportFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#ff6b6b" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImportedFromTcNo}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contas detectadas no loginusers.vdf -->
        <Border
            Padding="16,14"
            CornerRadius="10"
            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ic:SymbolIcon
                    Symbol="People"
                    FontSize="18"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="Contas do Steam detectadas automaticamente"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Todas as contas com Remember Password marcado serão importadas."
                        FontSize="12"
                        Opacity="0.5"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Text="Você também pode adicionar contas manualmente depois, nas configurações."
            FontSize="12"
            Opacity="0.4"
            Margin="0,16,0,0"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
