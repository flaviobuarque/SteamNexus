<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="AppCardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="AppButtonCornerRadius">8</CornerRadius>
    <BlurEffect x:Key="AppCardEffect" Radius="0" />

    <!-- ========================= -->
    <!-- BACKGROUNDS -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AppChromeBrush" Color="#E6EDF5"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#E8F1FC"/>

    <!-- ========================= -->
    <!-- BORDERS -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppBorderBrush" Color="#B8C5D1"/>
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#2563EB"/>

    <!-- ========================= -->
    <!-- TEXT -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B"/>

    <!-- ========================= -->
    <!-- ACCENT -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AppAccentAltBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#DBEAFE"/>

    <!-- ========================= -->
    <!-- SEMANTIC -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#FEE2E2"/>

    <SolidColorBrush x:Key="AppSuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#DCFCE7"/>

    <SolidColorBrush x:Key="AppWarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="AppWarningSurfaceBrush" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="AppOverlayBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="AppDialogBackdropBrush" Color="#660F172A"/>

    <!-- ========================= -->
    <!-- WPF UI ALIASES -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F1F5F9"/>

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"
                     Color="#EDF2F7"/>

    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"
                     Color="#E2E8F0"/>

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"
                     Color="#B8C5D1"/>

    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"
                     Color="#CBD5E1"/>

    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"
                     Color="#2563EB"/>

    <Color x:Key="SystemAccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"
                     Color="#0B1220"/>

    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"
                     Color="#334155"/>

    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"
                     Color="#64748B"/>

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"
                     Color="#F1F5F9"/>

    <SolidColorBrush x:Key="LayerFillColorAltBrush"
                     Color="#E6EDF5"/>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"
                     Color="#F1F5F9"/>

    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"
                     Color="#E6EDF5"/>

    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"
                     Color="#B8C5D1"/>

    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush"
                     Color="#E6EDF5"/>

    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush"
                     Color="#E6EDF5"/>

    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavigationViewTopPaneBackground"
                     Color="#F1F5F9"/>

    <!-- ========================= -->
    <!-- COMBOBOX -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ComboBoxDropDownBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxItemForeground"
                     Color="#0B1220"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"
                     Color="#DBEAFE"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"
                     Color="#E8F1FC"/>

    <SolidColorBrush x:Key="ComboBoxBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxBorderBrush"
                     Color="#B8C5D1"/>

    <SolidColorBrush x:Key="ComboBoxForeground"
                     Color="#0B1220"/>

    <!-- ========================= -->
    <!-- CONTEXT MENU -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ContextMenuBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ContextMenuBorderBrush"
                     Color="#B8C5D1"/>

    <SolidColorBrush x:Key="MenuItemHighlightBrush"
                     Color="#E8F1FC"/>

    <SolidColorBrush x:Key="MenuItemHighlightedForeground"
                     Color="#0B1220"/>

    <!-- ========================= -->
    <!-- SCROLLBAR -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppScrollThumbBrush"
                     Color="#64748B"/>

    <SolidColorBrush x:Key="AccountCardHeaderBrush"
                 Color="#E8F1FC"/>

    <SolidColorBrush x:Key="AccountCardActiveHeaderBrush"
                 Color="#BBF7D0"/>

    <SolidColorBrush x:Key="AccountCardSeparatorBrush"
                 Color="#B8C5D1"/>

    <SolidColorBrush x:Key="OnlineBrush"
                 Color="#15803D"/>

</ResourceDictionary>
