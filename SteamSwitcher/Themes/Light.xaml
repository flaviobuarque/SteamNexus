<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!-- BACKGROUNDS -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppChromeBrush" Color="#EEF3F7"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F4F8FB"/>
    <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#F4F9FF"/>

    <!-- ========================= -->
    <!-- BORDERS -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppBorderBrush" Color="#D4DEE7"/>
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#408EE3"/>

    <!-- ========================= -->
    <!-- TEXT -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#94A3B8"/>

    <!-- ========================= -->
    <!-- ACCENT -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppAccentBrush" Color="#408EE3"/>
    <SolidColorBrush x:Key="AppAccentAltBrush" Color="#3CCEFD"/>
    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#EAF4FF"/>

    <!-- ========================= -->
    <!-- SEMANTIC -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppDangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#FEF2F2"/>

    <SolidColorBrush x:Key="AppSuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#DCFCE7"/>

    <SolidColorBrush x:Key="AppWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AppOverlayBrush" Color="#AAFFFFFF"/>

    <!-- ========================= -->
    <!-- WPF UI ALIASES -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"
                     Color="#F4F8FB"/>

    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"
                     Color="#E7F1F6"/>

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"
                     Color="#D4DEE7"/>

    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"
                     Color="#E5EDF4"/>

    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"
                     Color="#408EE3"/>

    <Color x:Key="SystemAccentColor">#408EE3</Color>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"
                     Color="#0F172A"/>

    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"
                     Color="#475569"/>

    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"
                     Color="#94A3B8"/>

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"
                     Color="#F8FAFC"/>

    <SolidColorBrush x:Key="LayerFillColorAltBrush"
                     Color="#EEF3F7"/>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"
                     Color="#F8FAFC"/>

    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"
                     Color="#EEF3F7"/>

    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"
                     Color="#D4DEE7"/>

    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush"
                     Color="#EEF3F7"/>

    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush"
                     Color="#EEF3F7"/>

    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavigationViewTopPaneBackground"
                     Color="#F8FAFC"/>

    <!-- ========================= -->
    <!-- COMBOBOX -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ComboBoxDropDownBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxItemForeground"
                     Color="#0F172A"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"
                     Color="#EAF4FF"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"
                     Color="#F4F8FB"/>

    <SolidColorBrush x:Key="ComboBoxBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxBorderBrush"
                     Color="#D4DEE7"/>

    <SolidColorBrush x:Key="ComboBoxForeground"
                     Color="#0F172A"/>

    <!-- ========================= -->
    <!-- CONTEXT MENU -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ContextMenuBackground"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ContextMenuBorderBrush"
                     Color="#D4DEE7"/>

    <SolidColorBrush x:Key="MenuItemHighlightBrush"
                     Color="#F1F7FE"/>

    <SolidColorBrush x:Key="MenuItemHighlightedForeground"
                     Color="#0F172A"/>

    <!-- ========================= -->
    <!-- SCROLLBAR -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="AppScrollThumbBrush"
                     Color="#94A3B8"/>

    <SolidColorBrush x:Key="AccountCardHeaderBrush"
                 Color="#F1F7FE"/>

    <SolidColorBrush x:Key="AccountCardSeparatorBrush"
                 Color="#CBD5E1"/>

    <SolidColorBrush x:Key="OnlineBrush"
                 Color="#22C55E"/>

</ResourceDictionary>