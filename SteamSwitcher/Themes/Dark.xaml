<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="#07111F" />
    <SolidColorBrush x:Key="AppChromeBrush"         Color="#081827" />
    <SolidColorBrush x:Key="AppSurfaceBrush"        Color="#0D2135" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush"     Color="#102B45" />
    <SolidColorBrush x:Key="AppSurfaceHoverBrush"   Color="#16385D" />

    <!-- Bordas -->
    <SolidColorBrush x:Key="AppBorderBrush"         Color="#1F456A" />
    <SolidColorBrush x:Key="AppBorderStrongBrush"   Color="#408EE3" />

    <!-- Texto -->
    <SolidColorBrush x:Key="AppTextPrimaryBrush"    Color="#EAF7FF" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush"  Color="#A9C8DE" />
    <SolidColorBrush x:Key="AppTextMutedBrush"      Color="#6593B0" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AppAccentBrush"         Color="#408EE3" />
    <SolidColorBrush x:Key="AppAccentAltBrush"      Color="#3CCEFD" />
    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#102C4C" />

    <!-- Semânticas -->
    <SolidColorBrush x:Key="AppDangerBrush"         Color="#EF6A6A" />
    <SolidColorBrush x:Key="AppDangerSurfaceBrush"  Color="#341615" />
    <SolidColorBrush x:Key="AppSuccessBrush"        Color="#57E389" />
    <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#0D3324" />
    <SolidColorBrush x:Key="AppWarningBrush"        Color="#F2B84B" />
    <SolidColorBrush x:Key="AppOverlayBrush"        Color="#CC000000" />
    <SolidColorBrush x:Key="AppDialogBackdropBrush" Color="#88000000" />

    <!-- Aliases WPF-UI -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"              Color="#07111F" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"            Color="#0D2135" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"          Color="#102B45" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"           Color="#143A5C" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"          Color="#1F456A" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"        Color="#183650" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"           Color="#408EE3" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"               Color="#EAF7FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"             Color="#A9C8DE" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"              Color="#6593B0" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"              Color="#07111F" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush"                  Color="#081827" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"       Color="#07111F" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"  Color="#081827" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"    Color="#1F456A" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#081827" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush"     Color="#081827" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"     Color="#081827" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground"         Color="#081827" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"    Color="#081827" />
    <Color x:Key="SystemAccentColor">#408EE3</Color>

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground"         Color="#0D2135" />
    <SolidColorBrush x:Key="ComboBoxItemForeground"             Color="#EAF7FF" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"     Color="#16385D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"  Color="#102B45" />
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"        Color="#0D2135" />
    <SolidColorBrush x:Key="ComboBoxBackground"                 Color="#0D2135" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush"                Color="#1F456A" />
    <SolidColorBrush x:Key="ComboBoxForeground"                 Color="#EAF7FF" />

    <!-- ContextMenu -->
    <SolidColorBrush x:Key="ContextMenuBackground"              Color="#0D2135" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush"             Color="#1F456A" />
    <SolidColorBrush x:Key="MenuItemHighlightBrush"             Color="#143252" />
    <SolidColorBrush x:Key="MenuItemHighlightedForeground"      Color="#EAF7FF" />

    <!-- ScrollBar thumb -->
    <SolidColorBrush x:Key="AppScrollThumbBrush"                Color="#2A5A7A" />

    <SolidColorBrush x:Key="AccountCardHeaderBrush"
                 Color="#143252"/>

    <SolidColorBrush x:Key="AccountCardActiveHeaderBrush"
                 Color="#164E3A"/>

    <SolidColorBrush x:Key="AccountCardSeparatorBrush"
                 Color="#1F456A"/>

    <SolidColorBrush x:Key="OnlineBrush"
                 Color="#57E389"/>

</ResourceDictionary>
